+func TestDiscardDeferredAcquireRetainsUploadsAndReleasesOwnedLeaseOnce(t *testing.T) {
+	f := newDeferredAcquireFixture(t)
+	buffer, err := f.device.CreateBuffer(&wgpu.BufferDescriptor{Label: "deferred-pending-destination", Size: 32, Usage: wgpu.BufferUsageCopyDst})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = f.device.Queue().WriteBuffer(buffer, 0, make([]byte, 32)); err != nil {
+		t.Fatal(err)
+	}
+	pendingEncoder := f.raw.encoders[len(f.raw.encoders)-1]
+	destination := f.raw.buffers["deferred-pending-destination"]
+	buffer.Release() // The staged queue must still own its destination reference.
+	if !f.context.DisableDeferredFrameReplay() {
+		t.Fatal("entry did not admit no-replay policy")
+	}
+	encoder := f.context.CommandEncoder()
+	if encoder == nil {
+		t.Fatal("mock acquisition/encoder creation failed")
+	}
+	frameEncoder := f.raw.encoders[len(f.raw.encoders)-1]
+	lease := f.target.currentSurfaceTexture
+	view := f.target.currentView
+	if lease == nil {
+		t.Fatal("test did not acquire an owned surface lease")
+	}
+	f.target.overlayNeedsRedraw = true
+	if !f.context.DiscardDeferredAcquire() || !f.context.DiscardDeferredAcquire() {
+		t.Fatal("safe discard was not idempotently admitted")
+	}
+	if f.raw.surface.discarded != 1 || f.raw.viewsDestroyed != 0 || view.Texture() != nil || frameEncoder.discards != 1 || pendingEncoder.discards != 0 || f.raw.destroyed[destination] != 0 {
+		t.Fatal("discard released owned frame twice or dropped staged upload ownership")
+	}
+	if _, err := lease.CreateView(nil); err == nil {
+		t.Fatal("discarded surface lease remained usable")
+	}
+	if _, err := encoder.Finish(); err == nil {
+		t.Fatal("discarded shared encoder remained recordable")
+	}
+	if f.target.frameStarted || f.target.frameEncoder != nil || f.target.currentView != nil || f.target.currentSurfaceTexture != nil || f.target.hasGPUWork || !f.target.acquireFailed || f.target.overlayNeedsRedraw || !f.target.disableDeferredFrameReplay {
+		t.Fatal("discard did not route outer idle/redraw without overlay replay")
+	}
+	if f.queue.submits != 0 || f.queue.presents != 0 || f.raw.waits != 0 || f.device.Queue().LastSubmissionIndex() != 0 || f.device.Queue().Poll() != 0 || f.renderer.submissionError != nil {
+		t.Fatal("discard submitted, presented, waited, changed an index or published an error")
+	}
+	if err := f.device.WaitIdle(); err != nil {
+		t.Fatal(err)
+	}
+	if f.raw.viewsDestroyed != 1 || f.raw.destroyed[destination] != 0 || pendingEncoder.discards != 0 {
+		t.Fatal("ordinary completion maintenance discarded still-unsubmitted owned writes")
+	}
+	f.device.Release()
+	if f.raw.destroyed[destination] != 1 || pendingEncoder.discards != 1 {
+		t.Fatal("normal device teardown did not release retained pending writes exactly once")
+	}
+}
