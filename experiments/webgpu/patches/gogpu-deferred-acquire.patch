+func TestDeferredFrameReplayOutdatedConsumesSourceOnceWhenOptedIn(t *testing.T) {
+	for _, optIn := range []bool{false, true} {
+		t.Run(map[bool]string{false: "normal replay", true: "deferred fresh callback"}[optIn], func(t *testing.T) {
+			f := newDeferredAcquireFixture(t)
+			f.queue.outdatedOnce = true
+			app := &App{renderer: f.renderer, renderLoop: &mockRenderLoop{}}
+			draws, nextCalls := 0, 0
+			frames := []windowFrame{{window: &Window{surface: f.target}, scale: 1, physW: 1, physH: 1, onDraw: func(c *Context) {
+				draws++
+				nextCalls++ // Stand-in for the stateful producer's one Next/input drain.
+				if optIn && !c.DisableDeferredFrameReplay() {
+					t.Fatal("callback-entry opt-in refused")
+				}
+				if c.CommandEncoder() == nil {
+					t.Fatal("mock frame acquisition failed")
+				}
+			}}}
+			app.renderFrameGPU(frames)
+			want := 2
+			if optIn {
+				want = 1
+			}
+			if draws != want || nextCalls != want || f.queue.submits != want || f.queue.presents != want {
+				t.Fatalf("outdated cycle consumed source more than its policy: draw=%d next=%d submit=%d present=%d", draws, nextCalls, f.queue.submits, f.queue.presents)
+			}
+			if optIn && !app.pendingRedraw.Load() {
+				t.Fatal("outdated opt-in did not schedule a fresh external callback")
+			}
+			if f.renderer.submissionError != nil {
+				t.Fatal("recoverable outdated present published fatal submission error")
+			}
+			if optIn {
+				app.pendingRedraw.Store(false)
+				app.renderFrameGPU(frames)
+				if draws != 2 || nextCalls != 2 || app.pendingRedraw.Load() {
+					t.Fatal("fresh external callback failed to consume exactly its next source packet")
+				}
+			}
+		})
+	}
+}
