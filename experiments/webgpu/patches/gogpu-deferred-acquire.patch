+//go:build !rust && !(js && wasm)
+
+package gogpu
+
+import "github.com/gogpu/gputypes"
+
+// DeferredAcquireState reports the active surface's configured extent and
+// format. Stable additionally requires a configured surface, a positive equal
+// platform physical extent, and no live resize/move. It does not acquire an
+// image, prepare/reconfigure a surface, create commands, wait for the GPU, or
+// change frame state. The caller must revalidate after preparing its packet;
+// stable is a current observation, not a promise about a later acquisition.
+// Render-owner only, during this Context's OnDraw callback.
+func (c *Context) DeferredAcquireState() (width, height int, format gputypes.TextureFormat, stable bool) {
+	ws := c.deferredAcquireSurface()
+	if ws == nil {
+		return
+	}
+	width, height, format = int(ws.width), int(ws.height), ws.format
+	if !ws.CanRender() || width <= 0 || height <= 0 || ws.platWindow == nil || ws.platWindow.InSizeMove() {
+		return
+	}
+	physicalWidth, physicalHeight := ws.platWindow.PhysicalSize()
+	stable = physicalWidth > 0 && physicalHeight > 0 && physicalWidth == width && physicalHeight == height
+	return
+}
+
+// DisableDeferredFrameReplay opts this surface's current frame cycle out of
+// immediate OnDraw replay after an outdated present. Call at callback entry,
+// before acquisition, clear or content. A reconfigured surface then requests
+// a redraw for a fresh external callback. Normal callers retain the existing
+// single replay behavior. The opt-in resets at prepareLazyAcquire, not during
+// frame release/cancellation. Render-owner only.
+func (c *Context) DisableDeferredFrameReplay() bool {
+	ws := c.deferredAcquireSurface()
+	if ws == nil || c.cleared || ws.frameStarted || ws.frameEncoder != nil || ws.hasGPUWork || ws.pixelPresented {
+		return false
+	}
+	// frameCleared/externalContent can describe the previous released image
+	// until beginFrame resets them. Current-cycle clear/content calls start a
+	// frame (or set c.cleared), so the guards above still enforce entry order.
+	ws.disableDeferredFrameReplay = true
+	return true
+}
+
+// DiscardDeferredAcquire cancels only this surface's unsubmitted acquisition
+// and shared encoder, so the outer idle path requests a fresh callback.
+//
+// Precondition: call after deferred acquisition/extent validation and BEFORE
+// recording any commands through the borrowed encoder or publishing content.
+// GoGPU cannot inspect arbitrary external encoder recordings; the caller must
+// enforce that order. Known clear/content/present states are refused. No other
+// producer may have queued writes to this acquired surface texture, whose
+// acquisition lease is invalidated here. Queue-owned staged buffer/texture
+// uploads are preserved for the next Submit or normal Device.Release discard.
+// Render-owner only; no Submit, Present, GPU wait, error publication or new
+// completion claim occurs. The per-cycle no-replay opt-in is preserved.
+func (c *Context) DiscardDeferredAcquire() bool {
+	ws := c.deferredAcquireSurface()
+	if ws == nil || c.cleared || ws.pixelPresented ||
+		ws.frameStarted && (ws.frameCleared || ws.hasPendingClear || ws.externalContent) ||
+		ws.currentSurfaceTexture != nil && ws.surface == nil {
+		return false
+	}
+	ws.discardFrameEncoder()
+	if ws.currentSurfaceTexture != nil {
+		ws.surface.DiscardTexture()
+	}
+	ws.releaseFrame()
+	ws.resetLazyState()
+	ws.acquireFailed = true
+	ws.overlayNeedsRedraw = false // Suppress an overlay-only same-callback retry.
+	return true
+}
+
+func (c *Context) deferredAcquireSurface() *RenderTarget {
+	if c == nil {
+		return nil
+	}
+	if c.surface != nil {
+		return c.surface
+	}
+	if c.renderer != nil {
+		return c.renderer.primary
+	}
+	return nil
+}
