+func newDeferredAcquireFixture(t *testing.T) *deferredAcquireFixture {
+	t.Helper()
+	previous, ok := hal.GetBackend(gputypes.BackendEmpty)
+	if !ok {
+		t.Fatal("explicit noop/software test provider must already be registered")
+	}
+	// Core captures HAL providers once. Initialize that cache before replacing
+	// its software slot so the fixture works regardless of prior test order.
+	core.RegisterHALBackends()
+	previousCore, ok := core.GetBackendProvider(gputypes.BackendEmpty)
+	if !ok {
+		t.Fatal("explicit noop/software core test provider must already be registered")
+	}
+	f := &deferredAcquireFixture{
+		raw:   &deferredAcquireDevice{surface: &deferredAcquireSurface{}, buffers: make(map[string]hal.Buffer), destroyed: make(map[hal.Buffer]int)},
+		queue: &deferredAcquireQueue{}, window: &deferredAcquireWindow{mockWindow: mockWindow{width: 1, height: 1, scaleFactor: 1}},
+	}
+	backend := &deferredAcquireBackend{fixture: f}
+	hal.RegisterBackend(backend)
+	core.RegisterBackendProvider(backend)
+	t.Cleanup(func() {
+		defer hal.RegisterBackend(previous)
+		defer core.RegisterBackendProvider(previousCore)
+		if f.target != nil {
+			f.target.releaseFrame()
+		}
+		if f.device != nil {
+			f.device.Release()
+		}
+		if f.surface != nil {
+			f.surface.Release()
+		}
+		if f.adapter != nil {
+			f.adapter.Release()
+		}
+		if f.instance != nil {
+			f.instance.Release()
+		}
+	})
+	var err error
+	f.instance, err = wgpu.CreateInstance(&wgpu.InstanceDescriptor{Backends: gputypes.Backends(1 << gputypes.BackendEmpty)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.surface, err = f.instance.CreateSurfaceFromTarget(wgpu.HeadlessSurfaceTarget{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.adapter, err = f.instance.RequestAdapter(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.device, err = f.adapter.RequestDevice(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.renderer = &Renderer{device: f.device, adapter: f.adapter}
+	f.target = &RenderTarget{renderer: f.renderer, surface: f.surface, platWindow: f.window, width: 1, height: 1, format: gputypes.TextureFormatBGRA8Unorm}
+	f.renderer.primary = f.target
+	if err := f.target.configure(f.device, f.adapter); err != nil {
+		t.Fatal(err)
+	}
+	f.target.state = SurfaceConfigured
+	f.target.prepareLazyAcquire()
+	f.context = newContext(f.renderer, 1)
+	return f
+}
