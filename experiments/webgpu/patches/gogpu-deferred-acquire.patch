+func TestDeferredAcquireStateDoesNotAcquireOrMutate(t *testing.T) {
+	f := newDeferredAcquireFixture(t)
+	for _, test := range []struct {
+		name   string
+		change func()
+		stable bool
+	}{
+		{"configured equal", func() {}, true},
+		{"physical mismatch", func() { f.window.width = 2 }, false},
+		{"live resize", func() { f.window.width = 1; f.window.inSizeMove = true }, false},
+		{"zero physical", func() { f.window.inSizeMove = false; f.window.width = 0 }, false},
+		{"unconfigured", func() { f.window.width = 1; f.target.state = SurfaceReady }, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			test.change()
+			width, height, format, stable := f.context.DeferredAcquireState()
+			if width != 1 || height != 1 || format != gputypes.TextureFormatBGRA8Unorm || stable != test.stable {
+				t.Fatalf("snapshot %dx%d %v stable=%v", width, height, format, stable)
+			}
+			if f.raw.surface.acquired != 0 || f.window.prepares != 0 || f.raw.waits != 0 || f.queue.submits != 0 || f.queue.presents != 0 || f.target.frameStarted || f.target.frameEncoder != nil || f.renderer.submissionError != nil {
+				t.Fatal("state snapshot acquired, waited or mutated frame/error state")
+			}
+		})
+	}
+	for _, context := range []*Context{nil, {}, newContext(&Renderer{}, 1)} {
+		if w, h, _, stable := context.DeferredAcquireState(); w != 0 || h != 0 || stable {
+			t.Fatal("missing active surface reported stable configured dimensions")
+		}
+		if context.DisableDeferredFrameReplay() || context.DiscardDeferredAcquire() {
+			t.Fatal("missing active surface admitted mutation")
+		}
+	}
+}
