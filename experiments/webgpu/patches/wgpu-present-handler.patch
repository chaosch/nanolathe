+//go:build darwin && !(js && wasm)
+
+package metal
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"runtime"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"github.com/go-webgpu/goffi/ffi"
+	"github.com/go-webgpu/goffi/types"
+)
+
+const presentObservationLimit = 4096
+
+var nextDiagnosticSurface atomic.Uint64
+
+type presentationObservation struct {
+	Ordinal, Submission, Surface, Generation, Acquisition uint64
+	AcquireMS, PresentedSeconds                           float64
+	Reason                                                string
+	FreshSubmission                                       bool
+}
+type handlerKey struct{ pointer, id uintptr }
+type handlerEntry struct {
+	owner *presentTelemetry
+	token uint64
+}
+type handlerRouter struct {
+	mu      sync.Mutex
+	entries map[handlerKey]handlerEntry
+	late    atomic.Uint64
+}
+
+var presentedRouter = handlerRouter{entries: make(map[handlerKey]handlerEntry)}
+
+// This sole process helper is immutable and permanently rooted. Global blocks
+// are copied/released as no-ops; never unpin this literal/descriptor on timeout.
+var permanentPresented struct {
+	once       sync.Once
+	block      *blockLiteral
+	descriptor *blockDescriptor
+	pointer    atomic.Uintptr
+}
+
+func permanentPresentedBlock() uintptr {
+	permanentPresented.once.Do(func() {
+		// dlsym returns the class storage address, not its first word. Keep
+		// this diagnostic fix separate from inherited event blocks; resolve
+		// it once so ordinary frames do not add symbol lookup work.
+		classStorage, err := ffi.GetSymbol(objcLib, "_NSConcreteGlobalBlock")
+		if err != nil || classStorage == nil {
+			return
+		}
+		invoke := ffi.NewCallback(func(_ uintptr, drawable uintptr) {
+			if drawable == 0 {
+				return
+			}
+			key := handlerKey{pointer: drawable, id: uintptr(MsgSend(ID(drawable), Sel("drawableID")))}
+			// Remove/copy the owner before touching its lock. No global registry
+			// lock is held across native getters or tracker row publication.
+			entry, ok := presentedRouter.take(key)
+			if !ok {
+				presentedRouter.late.Add(1)
+				return
+			}
+			var value float64
+			err := msgSend(ID(drawable), Sel("presentedTime"), types.DoubleTypeDescriptor, unsafe.Pointer(&value))
+			entry.owner.complete(entry.token, key, value, err)
+		})
+		permanentPresented.descriptor = &blockDescriptor{size: uint64(unsafe.Sizeof(blockLiteral{}))}
+		permanentPresented.block = &blockLiteral{isa: uintptr(classStorage), flags: blockIsGlobal, invoke: invoke, descriptor: uintptr(unsafe.Pointer(permanentPresented.descriptor))}
+		permanentPresented.pointer.Store(uintptr(unsafe.Pointer(permanentPresented.block)))
+	})
+	return permanentPresented.pointer.Load()
+}
+func (r *handlerRouter) register(key handlerKey, entry handlerEntry) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if len(r.entries) >= presentObservationLimit {
+		return false
+	}
+	if _, exists := r.entries[key]; exists {
+		return false
+	}
+	r.entries[key] = entry
+	return true
+}
+func (r *handlerRouter) take(key handlerKey) (handlerEntry, bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	entry, ok := r.entries[key]
+	if ok {
+		delete(r.entries, key)
+	}
+	return entry, ok
+}
+func (r *handlerRouter) remove(key handlerKey, owner *presentTelemetry, token uint64) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if entry, ok := r.entries[key]; ok && entry.owner == owner && entry.token == token {
+		delete(r.entries, key)
+	}
+}
+func (r *handlerRouter) count() int { r.mu.Lock(); defer r.mu.Unlock(); return len(r.entries) }
+
+type pendingPresentation struct {
+	key       handlerKey
+	row       presentationObservation
+	requested time.Time
+}
+type presentationSnapshot struct {
+	Enabled, Closed                                                                 bool
+	Retains, Releases, Outstanding, HighWater, RegistryOutstanding, PermanentBlocks int
+	Requested, Presented, Missing, Callbacks, ValueEvictions, IgnoredAfterClose     uint64
+	Scope                                                                           string
+	Rows                                                                            []presentationObservation
+}
+type presentTelemetry struct {
+	mu                                                                  sync.Mutex
+	closed                                                              bool
+	now                                                                 func() time.Time
+	router                                                              *handlerRouter
+	pending                                                             map[uint64]pendingPresentation
+	rows                                                                []presentationObservation
+	nextRow, highWater                                                  int
+	ordinal, requested, presented, missing, callbacks, evicted, ignored uint64
+	lastSubmission                                                      map[uint64]uint64
+}
+
+func newPresentedTracker(router *handlerRouter) *presentTelemetry {
+	return &presentTelemetry{now: time.Now, router: router, pending: make(map[uint64]pendingPresentation), lastSubmission: make(map[uint64]uint64)}
+}
+func (q *Queue) presentationDiagnostic() *presentTelemetry {
+	if q == nil {
+		return nil
+	}
+	q.presentInit.Do(func() {
+		if runtime.GOARCH == "arm64" && os.Getenv("NANOLATHE_WEBGPU_PRESENT_TELEMETRY") == "1" {
+			q.presentDiagnostic = newPresentedTracker(&presentedRouter)
+		}
+	})
+	return q.presentDiagnostic
+}
+func (t *presentTelemetry) appendRow(row presentationObservation) {
+	if len(t.rows) == presentObservationLimit {
+		t.rows[t.nextRow] = row
+		t.nextRow = (t.nextRow + 1) % presentObservationLimit
+		t.evicted++
+	} else {
+		t.rows = append(t.rows, row)
+	}
+}
+func (t *presentTelemetry) finish(token uint64, value float64, reason string) {
+	p, exists := t.pending[token]
+	if !exists {
+		return
+	}
+	delete(t.pending, token)
+	t.router.remove(p.key, t, token)
+	p.row.PresentedSeconds = value
+	p.row.Reason = reason
+	if reason == "presented" {
+		t.presented++
+	} else {
+		t.missing++
+	}
+	t.appendRow(p.row)
+}
+func (t *presentTelemetry) expireLocked() {
+	now := t.now()
+	for token, p := range t.pending {
+		if now.Sub(p.requested) >= 250*time.Millisecond {
+			t.finish(token, 0, "handler-timeout-observation")
+		}
+	}
+}
+func (t *presentTelemetry) beforeAcquire() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.closed {
+		t.expireLocked()
+	}
+}
+func (t *presentTelemetry) register(key handlerKey, row presentationObservation, accepted bool) uint64 {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return 0
+	}
+	t.expireLocked()
+	t.ordinal++
+	t.requested++
+	row.Ordinal = t.ordinal
+	row.FreshSubmission = row.Submission > 0 && row.Submission > t.lastSubmission[row.Surface]
+	t.lastSubmission[row.Surface] = max(row.Submission, t.lastSubmission[row.Surface])
+	if !accepted {
+		row.Reason = "present-request-failed"
+		t.missing++
+		t.appendRow(row)
+		return 0
+	}
+	if len(t.pending) >= presentObservationLimit {
+		row.Reason = "owner-registry-budget"
+		t.missing++
+		t.appendRow(row)
+		return 0
+	}
+	token := t.ordinal
+	t.pending[token] = pendingPresentation{key: key, row: row, requested: t.now()}
+	if !t.router.register(key, handlerEntry{owner: t, token: token}) {
+		delete(t.pending, token)
+		row.Reason = "global-registry-budget-or-key-conflict"
+		t.missing++
+		t.appendRow(row)
+		return 0
+	}
+	t.highWater = max(t.highWater, len(t.pending))
+	return token
+}
+func (t *presentTelemetry) complete(token uint64, key handlerKey, value float64, err error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	p, ok := t.pending[token]
+	if t.closed || !ok || p.key != key {
+		t.ignored++
+		return
+	}
+	t.callbacks++
+	reason := "presented"
+	if err != nil {
+		reason = "handler-getter-error"
+		value = 0
+	} else if math.IsNaN(value) || math.IsInf(value, 0) || value < 0 {
+		reason = "handler-invalid-timestamp"
+		value = 0
+	} else if value == 0 {
+		reason = "handler-zero-observation"
+	}
+	t.finish(token, value, reason)
+}
+func (t *presentTelemetry) cancel(token uint64, reason string) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.finish(token, 0, reason)
+}
+func (t *presentTelemetry) closeSurface(surface uint64) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	t.expireLocked()
+	for token, p := range t.pending {
+		if p.row.Surface == surface {
+			t.finish(token, 0, "surface-reconfigured-or-closed")
+		}
+	}
+	delete(t.lastSubmission, surface)
+}
+func (t *presentTelemetry) snapshot(close bool) presentationSnapshot {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.closed {
+		t.expireLocked()
+		if close {
+			t.closed = true
+			for token := range t.pending {
+				t.finish(token, 0, "final-close-observation")
+			}
+		}
+	}
+	ordered := append([]presentationObservation(nil), t.rows[t.nextRow:]...)
+	ordered = append(ordered, t.rows[:t.nextRow]...)
+	sort.Slice(ordered, func(i, j int) bool { return ordered[i].Ordinal < ordered[j].Ordinal })
+	blocks := 0
+	if permanentPresented.pointer.Load() != 0 {
+		blocks = 1
+	}
+	return presentationSnapshot{Enabled: true, Closed: t.closed, Outstanding: len(t.pending), RegistryOutstanding: t.router.count(), HighWater: t.highWater, PermanentBlocks: blocks, Requested: t.requested, Presented: t.presented, Missing: t.missing, Callbacks: t.callbacks, ValueEvictions: t.evicted, IgnoredAfterClose: t.ignored, Rows: ordered, Scope: "MTLDrawable presented handler; one permanently rooted process block, bounded pointer+drawableID registry, zero extra drawable retains; timestamp0/missing is no display proof; no GPU timestamps or new waits"}
+}
+func (q *Queue) NativePresentationTelemetry(close bool) any {
+	if t := q.presentationDiagnostic(); t != nil {
+		return t.snapshot(close)
+	}
+	return presentationSnapshot{Enabled: false}
+}
+func (q *Queue) observePresent(s *Surface, st *SurfaceTexture, accepted bool) {
+	t := q.presentationDiagnostic()
+	if t == nil || s == nil || st == nil || st.drawable == 0 {
+		return
+	}
+	q.submissionMu.Lock()
+	index := q.submissionIndex
+	q.submissionMu.Unlock()
+	row := presentationObservation{Submission: index, Surface: s.diagnosticSurface, Generation: st.diagnosticGeneration, Acquisition: st.diagnosticAcquisition, AcquireMS: st.diagnosticAcquireMS}
+	if !accepted {
+		t.register(handlerKey{}, row, false)
+		return
+	}
+	block := permanentPresentedBlock()
+	if block == 0 {
+		t.register(handlerKey{}, row, false)
+		return
+	}
+	if !msgSendBool(st.drawable, Sel("respondsToSelector:"), argPointer(uintptr(Sel("addPresentedHandler:")))) {
+		t.register(handlerKey{}, row, false)
+		return
+	}
+	key := handlerKey{pointer: uintptr(st.drawable), id: uintptr(MsgSend(st.drawable, Sel("drawableID")))}
+	token := t.register(key, row, true)
+	if token == 0 {
+		return
+	}
+	// Stress-only qualification: GC happens outside both locks, before native
+	// registration. Never enable this fixture in performance comparisons.
+	if os.Getenv("NANOLATHE_WEBGPU_PRESENT_GC_STRESS") == "1" && token%120 == 0 {
+		runtime.GC()
+	}
+	// The route exists before native registration and presentation. No tracker
+	// or global registry lock is held across this possibly reentrant call.
+	if err := msgSend(st.drawable, Sel("addPresentedHandler:"), types.VoidTypeDescriptor, nil, argPointer(block)); err != nil {
+		t.cancel(token, fmt.Sprintf("handler-attach-error:%v", err))
+	}
+}
