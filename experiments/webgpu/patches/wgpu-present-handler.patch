+//go:build darwin && !(js && wasm)
+
+package metal
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestSharedPresentedTrackerLateCloseTimeoutLayerIdentity(t *testing.T) {
+	router := &handlerRouter{entries: map[handlerKey]handlerEntry{}}
+	tracker := newPresentedTracker(router)
+	now := time.Unix(0, 0)
+	tracker.now = func() time.Time { return now }
+	first, second := handlerKey{pointer: 1, id: 0}, handlerKey{pointer: 2, id: 0}
+	a := tracker.register(first, presentationObservation{Surface: 1, Submission: 1}, true)
+	b := tracker.register(second, presentationObservation{Surface: 2, Submission: 1}, true)
+	entry, ok := router.take(second)
+	if !ok || entry.token != b {
+		t.Fatal("per-layer drawableID0 collided")
+	}
+	entry.owner.complete(entry.token, second, 42, nil)
+	tracker.closeSurface(1)
+	tracker.complete(a, first, 43, nil)
+	snapshot := tracker.snapshot(true)
+	if snapshot.Presented != 1 || snapshot.Missing != 1 || snapshot.Outstanding != 0 || snapshot.RegistryOutstanding != 0 || snapshot.IgnoredAfterClose != 1 {
+		t.Fatalf("bad closure %+v", snapshot)
+	}
+	if tracker.register(handlerKey{3, 0}, presentationObservation{}, true) != 0 {
+		t.Fatal("registered after close")
+	}
+	tracker = newPresentedTracker(router)
+	tracker.now = func() time.Time { return now }
+	token := tracker.register(first, presentationObservation{}, true)
+	entry, _ = router.take(first)
+	now = now.Add(time.Second)
+	tracker.beforeAcquire()
+	entry.owner.complete(token, first, 44, nil)
+	if tracker.snapshot(true).Presented != 0 {
+		t.Fatal("expired route committed late data")
+	}
+}
+func TestSharedPresentedTrackerRacingCloseAndOutOfOrderCompletion(t *testing.T) {
+	for iteration := 0; iteration < 100; iteration++ {
+		router := &handlerRouter{entries: map[handlerKey]handlerEntry{}}
+		tracker := newPresentedTracker(router)
+		for i := uintptr(1); i <= 16; i++ {
+			tracker.register(handlerKey{i, i}, presentationObservation{Submission: uint64(i)}, true)
+		}
+		var wg sync.WaitGroup
+		for i := uintptr(16); i > 0; i-- {
+			wg.Add(1)
+			go func(i uintptr) {
+				defer wg.Done()
+				key := handlerKey{i, i}
+				entry, ok := router.take(key)
+				if ok {
+					entry.owner.complete(entry.token, key, float64(i), nil)
+				}
+			}(i)
+		}
+		wg.Add(1)
+		go func() { defer wg.Done(); tracker.snapshot(true) }()
+		wg.Wait()
+		snapshot := tracker.snapshot(true)
+		if snapshot.Outstanding != 0 || snapshot.RegistryOutstanding != 0 || snapshot.Requested != snapshot.Presented+snapshot.Missing {
+			t.Fatal("race lost request accounting")
+		}
+		for i := 1; i < len(snapshot.Rows); i++ {
+			if snapshot.Rows[i].Ordinal <= snapshot.Rows[i-1].Ordinal {
+				t.Fatal("snapshot rows unordered")
+			}
+		}
+	}
+}
+func TestSharedPresentedTrackerBoundsAndPointerReuse(t *testing.T) {
+	router := &handlerRouter{entries: map[handlerKey]handlerEntry{}}
+	tracker := newPresentedTracker(router)
+	for i := uintptr(0); i < presentObservationLimit+10; i++ {
+		tracker.register(handlerKey{pointer: 1, id: i}, presentationObservation{Submission: uint64(i)}, true)
+	}
+	if router.count() > presentObservationLimit {
+		t.Fatal("unbounded registry")
+	}
+	tracker.complete(1, handlerKey{pointer: 1, id: 99}, 42, nil)
+	if tracker.snapshot(false).Presented != 0 {
+		t.Fatal("pointer reuse crossed row generation")
+	}
+	snapshot := tracker.snapshot(true)
+	if snapshot.RegistryOutstanding != 0 || snapshot.Outstanding != 0 || snapshot.Retains != 0 || snapshot.Releases != 0 || len(snapshot.Rows) > presentObservationLimit {
+		t.Fatal("close/ring did not bound resources")
+	}
+}
