+package gogpu
+
+import (
+	"errors"
+	"github.com/gogpu/gputypes"
+	"github.com/gogpu/wgpu"
+	"github.com/gogpu/wgpu/hal"
+	"github.com/gogpu/wgpu/hal/noop"
+	"testing"
+)
+
+type rejectedFrameQueue struct {
+	noop.Queue
+	err     error
+	submits int
+}
+
+func (q *rejectedFrameQueue) Submit([]hal.CommandBuffer) (uint64, error) {
+	q.submits++
+	return 0, q.err
+}
+
+type unknownFrameDevice struct {
+	noop.Device
+	err error
+}
+
+func (d *unknownFrameDevice) WaitIdle() error { return d.err }
+func TestOwnedFrameSubmissionFailurePropagatesAndReleases(t *testing.T) {
+	sentinel := errors.New("frame rejected")
+	queue := &rejectedFrameQueue{err: sentinel}
+	device, err := wgpu.NewDeviceFromHAL(&noop.Device{}, queue, 0, gputypes.DefaultLimits(), "failed-frame")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer device.Release()
+	encoder, err := device.CreateCommandEncoder(&wgpu.CommandEncoderDescriptor{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	commands, err := encoder.Finish()
+	if err != nil {
+		t.Fatal(err)
+	}
+	renderer := &Renderer{device: device}
+	renderer.submitTracked(commands)
+	if !errors.Is(renderer.submissionError, sentinel) || renderer.tracker.activeCount() != 0 || queue.submits != 1 {
+		t.Fatal("failure was hidden or tracked as a success")
+	}
+	if _, err := device.Queue().Submit(commands); err == nil || queue.submits != 1 {
+		t.Fatal("failed command ownership was leaked")
+	}
+	renderer.recordSubmissionError(errors.New("later"))
+	if !errors.Is(renderer.submissionError, sentinel) {
+		t.Fatal("first failure overwritten")
+	}
+}
+func TestOwnedTrackerDoesNotFreeUnknownWork(t *testing.T) {
+	sentinel := errors.New("unknown completion")
+	raw := &unknownFrameDevice{err: sentinel}
+	device, err := wgpu.NewDeviceFromHAL(raw, &countingSubmitQueue{}, 0, gputypes.DefaultLimits(), "unknown-frame")
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoder, _ := device.CreateCommandEncoder(&wgpu.CommandEncoderDescriptor{})
+	commands, err := encoder.Finish()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var tracker submissionTracker
+	tracker.track(7, commands)
+	if err := tracker.waitAll(device); !errors.Is(err, sentinel) || tracker.activeCount() != 1 {
+		t.Fatal("failed wait recycled unknown command")
+	}
+	raw.err = nil
+	if err := tracker.waitAll(device); err != nil || tracker.activeCount() != 0 {
+		t.Fatal("confirmed wait failed to release commands")
+	}
+	device.Release()
+}
+
+func TestOwnedHeadlessReadbackRejectedSubmitReturnsFailure(t *testing.T) {
+	sentinel := errors.New("readback rejected")
+	queue := &rejectedFrameQueue{err: sentinel}
+	device, err := wgpu.NewDeviceFromHAL(&noop.Device{}, queue, 0, gputypes.DefaultLimits(), "failed-readback")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer device.Release()
+	texture, err := device.CreateTexture(&wgpu.TextureDescriptor{Size: wgpu.Extent3D{Width: 1, Height: 1, DepthOrArrayLayers: 1}, MipLevelCount: 1, SampleCount: 1, Dimension: wgpu.TextureDimension2D, Format: wgpu.TextureFormatRGBA8Unorm, Usage: wgpu.TextureUsageCopySrc})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer texture.Release()
+	renderer := &Renderer{device: device}
+	image, err := renderer.renderToImageReadback(texture, wgpu.TextureFormatRGBA8Unorm, 1, 1)
+	if image != nil || !errors.Is(err, sentinel) || queue.submits != 1 {
+		t.Fatalf("readback falsely succeeded: %v", err)
+	}
+}
+func TestOwnedFailedFinishDoesNotCountFrame(t *testing.T) {
+	ctx, target, queue := newSharedEncoderTestContext(t)
+	ctx.CommandEncoder().CopyBufferToBuffer(nil, 0, nil, 0, 1)
+	target.renderer.endFrameForSurface(target)
+	if target.renderer.submissionError == nil || target.frameNumber != 0 || queue.submits != 0 {
+		t.Fatal("failed frame counted or submitted")
+	}
+}
+
+func (q *rejectedFrameQueue) SubmitErrorsBeforeCommit() bool { return true }
+
+type ownedFinalWaitFailure struct {
+	noop.Device
+	calls int
+	err   error
+}
+
+func (d *ownedFinalWaitFailure) WaitIdle() error {
+	d.calls++
+	if d.calls == 2 {
+		return d.err
+	}
+	return nil
+}
+func TestOwnedFinalReleaseWaitFailurePropagates(t *testing.T) {
+	sentinel := errors.New("final release completion unknown")
+	raw := &ownedFinalWaitFailure{err: sentinel}
+	device, err := wgpu.NewDeviceFromHAL(raw, &countingSubmitQueue{}, 0, gputypes.DefaultLimits(), "final-release-test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	renderer := &Renderer{device: device}
+	renderer.Destroy()
+	if !errors.Is(renderer.submissionError, sentinel) || renderer.device != device {
+		t.Fatal("final release failure hidden or device graph discarded")
+	}
+	if _, kept := failedRendererTeardowns.Load(renderer); !kept {
+		t.Fatal("failed renderer not quarantined")
+	}
+}
+
+func TestOwnedCallbackErrorAbortsBeforeSubmission(t *testing.T) {
+	ctx, target, queue := newSharedEncoderTestContext(t)
+	ctx.CommandEncoder()
+	sentinel := errors.New("callback failed")
+	app := &App{renderer: target.renderer}
+	app.AbortFrame(sentinel)
+	target.renderer.endFrameForSurface(target)
+	if !errors.Is(target.renderer.submissionError, sentinel) || target.frameNumber != 0 || queue.submits != 0 || target.frameEncoder != nil {
+		t.Fatal("failed callback submitted or counted")
+	}
+}
