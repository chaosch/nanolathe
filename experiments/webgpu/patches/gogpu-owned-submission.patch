+// Copyright 2026 The Nanolathe Authors
+// SPDX-License-Identifier: MIT
+package gogpu
+
+import "sync"
+
+// Render-thread owned. App checks it after the serialized render callback.
+func (r *Renderer) recordSubmissionError(err error) {
+	if err != nil && r.submissionError == nil {
+		r.submissionError = err
+	}
+}
+
+// Completion unknown is terminal and must preserve the entire native graph.
+// These quarantines are not a loss recovery implementation.
+var failedAppTeardowns sync.Map
+var failedRendererTeardowns sync.Map
+
+// SubmissionFailuresReturned identifies the diagnostic host error contract.
+func (a *App) SubmissionFailuresReturned() bool { return true }
+
+var failedCommandBatches sync.Map
+
+// AbortFrame propagates a callback-owned failure before submission/presentation.
+func (a *App) AbortFrame(err error) {
+	if a.renderer != nil {
+		a.renderer.recordSubmissionError(err)
+	}
+}
