+	mapBuffer, _ := device.CreateBuffer(&BufferDescriptor{Size: 16, Usage: BufferUsageMapRead | BufferUsageCopyDst})
+	if _, err = mapBuffer.MapAsync(MapModeRead, 0, 16); !errors.As(err, &unknown) {
+		t.Fatal("unknown submission allowed fresh mapping")
