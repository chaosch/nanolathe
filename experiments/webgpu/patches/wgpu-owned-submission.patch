+	}
+	texture.DecPendingRef()
+	if texture.device != nil || texture.pendingRefs != 0 {
+		t.Fatal("last copy did not retire texture")
+	}
+	device.DestroyTexture(texture) // Idempotent physical retirement, no native raw handle.
+}
