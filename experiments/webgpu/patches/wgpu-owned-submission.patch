+
+// pendingBuffer retains copy-only public destinations without duplicating their
+// storage. A render/compute binding is not required to establish ownership.
+type pendingBuffer struct {
+	buffer hal.Buffer
+	ref    *core.ResourceRef
+}
+
+func dropPendingBuffers(buffers []pendingBuffer) {
+	for _, b := range buffers {
+		if b.ref != nil {
+			b.ref.Drop()
+		}
+	}
+}
