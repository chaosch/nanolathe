+func TestOwnedPendingBufferRetainsUntilCompletion(t *testing.T) {
+	pw, dev, q := createBatchingPW(t)
+	defer pw.destroy()
+	dst, err := dev.CreateBuffer(&hal.BufferDescriptor{Size: 16, Usage: gputypes.BufferUsageCopyDst})
+	if err != nil {
+		t.Fatal(err)
+	}
+	destroyed := 0
+	ref := core.NewResourceRef("copy-only", func() { destroyed++ })
+	source := []byte{1, 2, 3, 4}
+	for range 2 {
+		if err := pw.writeBufferRef(ref, dst, gputypes.BufferUsageCopyDst, 0, source); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if ref.RefCount() != 2 {
+		t.Fatal("duplicate writes must retain only once")
+	}
+	source[0] = 9
+	if q.lastWriteData[0] != 1 {
+		t.Fatal("upload did not own source bytes")
+	}
+	ref.Drop()
+	if destroyed != 0 {
+		t.Fatal("copy-only destination retired before submit")
+	}
+	cmd, enc, tex, buffers, err := pw.flush()
+	if err != nil {
+		t.Fatal(err)
+	}
+	pw.inflight = append(pw.inflight, inflightSubmission{submissionIndex: 5, cmdBuf: cmd, encoder: enc, dstTextures: tex, dstBuffers: buffers})
+	pw.maintain(4)
+	if destroyed != 0 || ref.RefCount() != 1 {
+		t.Fatal("incomplete copy retired")
+	}
+	pw.maintain(5)
+	pw.maintain(5)
+	if destroyed != 1 || ref.RefCount() != 0 {
+		t.Fatal("completed copy reference not dropped exactly once")
+	}
+}
+func TestOwnedPendingBufferDiscardAndCancel(t *testing.T) {
+	for _, flush := range []bool{false, true} {
+		t.Run(map[bool]string{false: "recording", true: "flushed"}[flush], func(t *testing.T) {
+			pw, dev, _ := createBatchingPW(t)
+			defer pw.destroy()
+			dst, _ := dev.CreateBuffer(&hal.BufferDescriptor{Size: 16, Usage: gputypes.BufferUsageCopyDst})
+			destroyed := 0
+			ref := core.NewResourceRef("abandoned", func() { destroyed++ })
+			if err := pw.writeBufferRef(ref, dst, gputypes.BufferUsageCopyDst, 0, []byte{1, 2, 3, 4}); err != nil {
+				t.Fatal(err)
+			}
+			ref.Drop()
+			if flush {
+				cmd, enc, tex, buffers, err := pw.flush()
+				if err != nil {
+					t.Fatal(err)
+				}
+				pw.cancelFlush(cmd, enc, tex, buffers)
+			} else {
+				pw.discardRecording()
+			}
+			if destroyed != 1 || ref.RefCount() != 0 {
+				t.Fatal("abandoned copy reference unbalanced")
+			}
+		})
+	}
+}
