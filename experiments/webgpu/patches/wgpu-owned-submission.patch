+func TestOwnedSubmissionPreflightFailures(t *testing.T) {
+	for _, mode := range []string{"invalid", "gpu-block", "frame-block"} {
+		t.Run(mode, func(t *testing.T) {
+			q := &Queue{submissionIndex: 7, frameSemaphore: make(chan struct{}, 3)}
+			q.completedIndex.Store(4)
+			q.frameSemaphore <- struct{}{}
+			q.frameSemaphore <- struct{}{}
+			q.frameSemaphore <- struct{}{}
+			commits, attachments, discards := 0, 0, 0
+			rt := metalSubmissionRuntime{gpuBlock: func(*atomic.Uint64, uint64) uintptr {
+				if mode == "gpu-block" {
+					return 0
+				}
+				return 11
+			}, frameBlock: func(chan struct{}) uintptr {
+				if mode == "frame-block" {
+					return 0
+				}
+				return 12
+			}, discard: func(uintptr) { discards++ }, attach: func(ID, uintptr) { attachments++ }, commit: func(ID) { commits++ }}
+			buffers := []hal.CommandBuffer{&CommandBuffer{raw: 1}, &CommandBuffer{raw: 2}}
+			if mode == "invalid" {
+				buffers[1] = &CommandBuffer{}
+			}
+			_, err := q.submitWithRuntime(buffers, rt)
+			if err == nil || !strings.Contains(err.Error(), "no commands committed") {
+				t.Fatalf("error=%v", err)
+			}
+			if commits != 0 || attachments != 0 || q.submissionIndex != 7 || q.completedIndex.Load() != 4 || len(q.frameSemaphore) != 3 {
+				t.Fatal("rejected submission changed completion/ownership")
+			}
+			if mode == "frame-block" && discards != 1 {
+				t.Fatal("unregistered GPU block leaked")
+			}
+		})
+	}
+}
+func TestOwnedSubmissionPublishesOnlyAfterRealCompletion(t *testing.T) {
+	q := &Queue{submissionIndex: 7, frameSemaphore: make(chan struct{}, 3)}
+	q.completedIndex.Store(4)
+	q.frameSemaphore <- struct{}{}
+	var target *atomic.Uint64
+	var value uint64
+	commits, attachments := 0, 0
+	rt := metalSubmissionRuntime{gpuBlock: func(p *atomic.Uint64, i uint64) uintptr { target, value = p, i; return 11 }, frameBlock: func(chan struct{}) uintptr { return 12 }, discard: func(uintptr) { t.Fatal("discarded valid block") }, attach: func(ID, uintptr) { attachments++ }, commit: func(ID) { commits++ }}
+	got, err := q.submitWithRuntime([]hal.CommandBuffer{&CommandBuffer{raw: 1}, &CommandBuffer{raw: 2}}, rt)
+	if err != nil || got != 8 || commits != 2 || attachments != 2 || q.completedIndex.Load() != 4 || len(q.frameSemaphore) != 0 {
+		t.Fatalf("invalid pre-completion state: %v", err)
+	}
+	target.Store(value)
+	q.frameSemaphore <- struct{}{}
+	if q.PollCompleted() != 8 || len(q.frameSemaphore) != 1 {
+		t.Fatal("completion did not retire exactly one frame")
+	}
+	before := q.submissionIndex
+	got, err = q.submitWithRuntime(nil, rt)
+	if err != nil || got != before || q.completedIndex.Load() != 8 || len(q.frameSemaphore) != 1 {
+		t.Fatal("empty submit invented work")
+	}
+}
+func TestOwnedIdleFailureDoesNotPublishCompletion(t *testing.T) {
+	for _, status := range []uint{0, 3, 5, 4} {
+		t.Run(string(rune('0'+status)), func(t *testing.T) {
+			q := &Queue{submissionIndex: 9, frameSemaphore: make(chan struct{}, 3)}
+			q.completedIndex.Store(2)
+			q.frameSemaphore <- struct{}{}
+			d := &Device{queue: q}
+			releases := 0
+			rt := metalIdleRuntime{create: func() ID {
+				if status == 0 {
+					return 0
+				}
+				return 3
+			}, retain: func(ID) {}, release: func(ID) { releases++ }, commit: func(ID) {}, wait: func(ID) {}, status: func(ID) uint { return status }}
+			err := d.waitIdleWithRuntime(rt)
+			if status == 4 {
+				if err != nil || q.completedIndex.Load() != 9 {
+					t.Fatalf("valid barrier failed: %v", err)
+				}
+			} else if err == nil || q.completedIndex.Load() != 2 {
+				t.Fatal("failed barrier falsely completed work")
+			}
+			if len(q.frameSemaphore) != 1 {
+				t.Fatal("idle wait duplicated semaphore tokens")
+			}
+			if (status != 0) != (releases == 1) {
+				t.Fatal("barrier lifetime unbalanced")
+			}
+		})
+	}
+}
+
+func TestOwnedIdleBarrierSerializesLaterSubmit(t *testing.T) {
+	q := &Queue{submissionIndex: 7}
+	q.completedIndex.Store(4)
+	d := &Device{queue: q}
+	waiting, release := make(chan struct{}), make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		done <- d.waitIdleWithRuntime(metalIdleRuntime{
+			create: func() ID { return 3 }, retain: func(ID) {}, release: func(ID) {}, commit: func(ID) {},
+			wait: func(ID) { close(waiting); <-release }, status: func(ID) uint { return 4 },
+		})
+	}()
+	<-waiting
+	attempted, submitted := make(chan struct{}), make(chan error, 1)
+	go func() {
+		close(attempted)
+		_, err := q.submitWithRuntime([]hal.CommandBuffer{&CommandBuffer{raw: 2}}, metalSubmissionRuntime{
+			gpuBlock: func(*atomic.Uint64, uint64) uintptr { return 11 }, attach: func(ID, uintptr) {}, commit: func(ID) {},
+		})
+		submitted <- err
+	}()
+	<-attempted
+	select {
+	case <-submitted:
+		t.Fatal("later work committed during idle barrier")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-submitted; err != nil {
+		t.Fatal(err)
+	}
+	if q.submissionIndex != 8 || q.PollCompleted() != 7 {
+		t.Fatal("idle barrier falsely completed later submission")
+	}
+}
