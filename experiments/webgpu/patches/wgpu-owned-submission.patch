+// packOwnedTextureData bounds every staging write to its allocation and copies
+// only texels required by the extent. Row/image padding belongs to staging.
+func packOwnedTextureData(buf *[]byte, owner *Texture, data []byte, layout *hal.ImageDataLayout, size *hal.Extent3D) ([]byte, uint32, uint32, error) {
+	if size.Width == 0 || size.Height == 0 {
+		return nil, 0, 0, fmt.Errorf("wgpu: empty texture extent")
+	}
+	rowBytes, blockRows := uint64(layout.BytesPerRow), uint64(size.Height)
+	if owner != nil {
+		format := owner.format
+		if format == gputypes.TextureFormatUndefined && owner.coreTexture != nil {
+			format = owner.coreTexture.Format()
+		}
+		bw, bh, bs, ok := ownedTextureFormatBlockInfo(format)
+		if !ok {
+			return nil, 0, 0, fmt.Errorf("wgpu: unsupported texture copy format %s", owner.format)
+		}
+		rowBytes = ((uint64(size.Width) + uint64(bw) - 1) / uint64(bw)) * uint64(bs)
+		blockRows = (uint64(size.Height) + uint64(bh) - 1) / uint64(bh)
+	}
+	if rowBytes == 0 || rowBytes > uint64(^uint32(0))-255 {
+		return nil, 0, 0, fmt.Errorf("wgpu: texture copied row overflow")
+	}
+	srcStride := uint64(layout.BytesPerRow)
+	if srcStride == 0 {
+		srcStride = rowBytes
+	}
+	rows := uint64(layout.RowsPerImage)
+	if rows == 0 {
+		rows = blockRows
+	}
+	layers := uint64(size.DepthOrArrayLayers)
+	if layers == 0 {
+		layers = 1
+	}
+	if srcStride < rowBytes || rows < blockRows {
+		return nil, 0, 0, fmt.Errorf("wgpu: texture source stride smaller than copy extent")
+	}
+	pitch := (rowBytes + 255) &^ uint64(255)
+	// Bound before multiplying: both native slice allocation and single texture
+	// upload packing has a1GiB CPU bound; GPU allocations are split at the belt limit.
+	if rows > maxOwnedTextureUploadSize/pitch || layers > maxOwnedTextureUploadSize/(pitch*rows) {
+		return nil, 0, 0, fmt.Errorf("wgpu: texture staging size exceeds1GiB")
+	}
+	total := pitch * rows * layers
+	if layout.Offset > uint64(len(data)) {
+		return nil, 0, 0, fmt.Errorf("wgpu: texture source offset outside data")
+	}
+	if srcStride > uint64(^uint32(0)) || rows*layers > (^uint64(0)-layout.Offset-rowBytes)/srcStride {
+		return nil, 0, 0, fmt.Errorf("wgpu: texture source range overflow")
+	}
+	needed := layout.Offset + ((layers-1)*rows+blockRows-1)*srcStride + rowBytes
+	if layout.Offset > uint64(len(data)) || needed > uint64(len(data)) {
+		return nil, 0, 0, fmt.Errorf("wgpu: texture source data too short: need%d have%d", needed, len(data))
+	}
+	if uint64(cap(*buf)) < total {
+		*buf = make([]byte, total)
+	} else {
+		*buf = (*buf)[:total]
+		clear(*buf)
+	}
+	for layer := uint64(0); layer < layers; layer++ {
+		for row := uint64(0); row < blockRows; row++ {
+			src := layout.Offset + (layer*rows+row)*srcStride
+			dst := (layer*rows + row) * pitch
+			copy((*buf)[dst:dst+rowBytes], data[src:src+rowBytes])
+		}
+	}
+	return *buf, uint32(pitch), uint32(rows), nil
+}
+
+func ownedTextureFormatBlockInfo(format gputypes.TextureFormat) (width, height, size uint32, ok bool) {
+	blockSize := format.BlockCopySize()
+	if blockSize == 0 {
+		return 0, 0, 0, false
+	}
+
+	switch format {
+	case gputypes.TextureFormatBC1RGBAUnorm,
+		gputypes.TextureFormatBC1RGBAUnormSrgb,
+		gputypes.TextureFormatBC2RGBAUnorm,
+		gputypes.TextureFormatBC2RGBAUnormSrgb,
+		gputypes.TextureFormatBC3RGBAUnorm,
+		gputypes.TextureFormatBC3RGBAUnormSrgb,
+		gputypes.TextureFormatBC4RUnorm,
+		gputypes.TextureFormatBC4RSnorm,
+		gputypes.TextureFormatBC5RGUnorm,
+		gputypes.TextureFormatBC5RGSnorm,
+		gputypes.TextureFormatBC6HRGBUfloat,
+		gputypes.TextureFormatBC6HRGBFloat,
+		gputypes.TextureFormatBC7RGBAUnorm,
+		gputypes.TextureFormatBC7RGBAUnormSrgb,
+		gputypes.TextureFormatETC2RGB8Unorm,
+		gputypes.TextureFormatETC2RGB8UnormSrgb,
+		gputypes.TextureFormatETC2RGB8A1Unorm,
+		gputypes.TextureFormatETC2RGB8A1UnormSrgb,
+		gputypes.TextureFormatETC2RGBA8Unorm,
+		gputypes.TextureFormatETC2RGBA8UnormSrgb,
+		gputypes.TextureFormatEACR11Unorm,
+		gputypes.TextureFormatEACR11Snorm,
+		gputypes.TextureFormatEACRG11Unorm,
+		gputypes.TextureFormatEACRG11Snorm:
+		return 4, 4, blockSize, true
+	}
+
+	switch format {
+	case gputypes.TextureFormatASTC4x4Unorm, gputypes.TextureFormatASTC4x4UnormSrgb:
+		return 4, 4, blockSize, true
+	case gputypes.TextureFormatASTC5x4Unorm, gputypes.TextureFormatASTC5x4UnormSrgb:
+		return 5, 4, blockSize, true
+	case gputypes.TextureFormatASTC5x5Unorm, gputypes.TextureFormatASTC5x5UnormSrgb:
+		return 5, 5, blockSize, true
+	case gputypes.TextureFormatASTC6x5Unorm, gputypes.TextureFormatASTC6x5UnormSrgb:
+		return 6, 5, blockSize, true
+	case gputypes.TextureFormatASTC6x6Unorm, gputypes.TextureFormatASTC6x6UnormSrgb:
+		return 6, 6, blockSize, true
+	case gputypes.TextureFormatASTC8x5Unorm, gputypes.TextureFormatASTC8x5UnormSrgb:
+		return 8, 5, blockSize, true
+	case gputypes.TextureFormatASTC8x6Unorm, gputypes.TextureFormatASTC8x6UnormSrgb:
+		return 8, 6, blockSize, true
+	case gputypes.TextureFormatASTC8x8Unorm, gputypes.TextureFormatASTC8x8UnormSrgb:
+		return 8, 8, blockSize, true
+	case gputypes.TextureFormatASTC10x5Unorm, gputypes.TextureFormatASTC10x5UnormSrgb:
+		return 10, 5, blockSize, true
+	case gputypes.TextureFormatASTC10x6Unorm, gputypes.TextureFormatASTC10x6UnormSrgb:
+		return 10, 6, blockSize, true
+	case gputypes.TextureFormatASTC10x8Unorm, gputypes.TextureFormatASTC10x8UnormSrgb:
+		return 10, 8, blockSize, true
+	case gputypes.TextureFormatASTC10x10Unorm, gputypes.TextureFormatASTC10x10UnormSrgb:
+		return 10, 10, blockSize, true
+	case gputypes.TextureFormatASTC12x10Unorm, gputypes.TextureFormatASTC12x10UnormSrgb:
+		return 12, 10, blockSize, true
+	case gputypes.TextureFormatASTC12x12Unorm, gputypes.TextureFormatASTC12x12UnormSrgb:
+		return 12, 12, blockSize, true
+	default:
+		return 1, 1, blockSize, true
+	}
+}
+
+const maxOwnedTextureUploadSize uint64 = 1 << 30
+
+// Copy each bounded staging buffer into its own rows/layer. A buffer chunk
+// boundary is never interpreted as a complete large texture source.
+func (pw *pendingWrites) recordOwnedTextureCopies(enc hal.CommandEncoder, owner *Texture, dst *hal.ImageCopyTexture, data []byte, pitch, rows uint32, size *hal.Extent3D) error {
+	blockHeight := uint32(1)
+	if owner != nil {
+		format := owner.format
+		if format == gputypes.TextureFormatUndefined && owner.coreTexture != nil {
+			format = owner.coreTexture.Format()
+		}
+		_, blockHeight, _, _ = ownedTextureFormatBlockInfo(format)
+	}
+	blockRows := (uint64(size.Height) + uint64(blockHeight) - 1) / uint64(blockHeight)
+	perChunk := pw.belt.maxStagingBufferSize / uint64(pitch)
+	if perChunk == 0 {
+		return fmt.Errorf("wgpu: texture row exceeds staging allocation limit")
+	}
+	layers := uint64(size.DepthOrArrayLayers)
+	if layers == 0 {
+		layers = 1
+	}
+	for layer := uint64(0); layer < layers; layer++ {
+		for row := uint64(0); row < blockRows; {
+			count := min(perChunk, blockRows-row)
+			begin := (layer*uint64(rows) + row) * uint64(pitch)
+			length := count * uint64(pitch)
+			alloc, err := pw.belt.allocate(length, data[begin:begin+length])
+			if err != nil {
+				return err
+			}
+			origin := *dst
+			origin.Origin.Y += uint32(row * uint64(blockHeight))
+			origin.Origin.Z += uint32(layer)
+			copyHeight := min(uint32(count*uint64(blockHeight)), size.Height-uint32(row*uint64(blockHeight)))
+			region := [1]hal.BufferTextureCopy{{BufferLayout: hal.ImageDataLayout{Offset: alloc.offset, BytesPerRow: pitch, RowsPerImage: uint32(count)}, TextureBase: origin, Size: hal.Extent3D{Width: size.Width, Height: copyHeight, DepthOrArrayLayers: 1}}}
+			enc.CopyBufferToTexture(alloc.buffer, dst.Texture, region[:])
+			row += count
+		}
+	}
+	return nil
+}
