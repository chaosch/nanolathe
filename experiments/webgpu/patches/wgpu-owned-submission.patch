+func TestOwnedTextureSplitsAtRowsAndLayers(t *testing.T) {
+	queue := &mockBatchingQueue{}
+	encoder := &ownedCopyEncoder{queue: queue}
+	device := &ownedCopyDevice{encoder: encoder}
+	pool := newEncoderPool(device)
+	defer pool.destroy()
+	pw := newPendingWrites(device, queue, pool)
+	defer pw.destroy()
+	pw.belt.maxStagingBufferSize = 512
+	raw := &noop.Texture{}
+	owner := &Texture{hal: raw, format: gputypes.TextureFormatRGBA8Unorm}
+	data := make([]byte, 24)
+	for i := range data {
+		data[i] = byte(i + 1)
+	}
+	if err := pw.writeTextureFor(owner, &hal.ImageCopyTexture{Texture: raw, Origin: hal.Origin3D{Y: 5, Z: 2}}, data, &hal.ImageDataLayout{BytesPerRow: 4, RowsPerImage: 3}, &hal.Extent3D{Width: 1, Height: 3, DepthOrArrayLayers: 2}); err != nil {
+		t.Fatal(err)
+	}
+	if len(encoder.copies) != 4 {
+		t.Fatal("large texture did not split by complete rows and layers")
+	}
+	for i, c := range encoder.copies {
+		layer, part := i/2, i%2
+		height := uint32(2)
+		if part == 1 {
+			height = 1
+		}
+		if c.region.TextureBase.Origin.Y != uint32(5+part*2) || c.region.TextureBase.Origin.Z != uint32(2+layer) || c.region.Size.Height != height || c.region.Size.DepthOrArrayLayers != 1 || len(c.data) != int(height)*256 {
+			t.Fatalf("copy%d wrong destination/length", i)
+		}
+		for row := range int(height) {
+			for x := range 4 {
+				if c.data[row*256+x] != data[(layer*3+part*2+row)*4+x] {
+					t.Fatal("row/layer data lost at chunk boundary")
+				}
+			}
+		}
+	}
+}
