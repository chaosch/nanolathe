+func TestOwnedUnclassifiedSubmitPreservesCompleteBatch(t *testing.T) {
+	raw := &ownedDestroyDevice{}
+	queue := &ownedUnknownQueue{mockBatchingQueue: mockBatchingQueue{submitErr: errors.New("possibly committed")}}
+	device, err := NewDeviceFromHAL(raw, queue, 0, gputypes.DefaultLimits(), "unknown-submit-test")
