+	buffer.Release()
+	encoder, _ := device.CreateCommandEncoder(&CommandEncoderDescriptor{})
+	commands, _ := encoder.Finish()
+	ownedEncoder := commands.halEncoder
+	callerSlice := []*CommandBuffer{commands}
+	_, err = device.Queue().Submit(callerSlice...)
+	callerSlice[0] = nil
+	commands.Release()
+	if commands.halEncoder != ownedEncoder {
+		t.Fatal("unknown command buffer recycled by Release")
+	}
+	var unknown interface{ CompletionUnknown() bool }
+	if !errors.As(err, &unknown) || !unknown.CompletionUnknown() || buffer.core.Ref.RefCount() != 1 || raw.destroyed != 0 {
+		t.Fatal("possibly committed upload recycled")
