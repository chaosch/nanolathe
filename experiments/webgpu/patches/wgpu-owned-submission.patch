+//go:build darwin && !(js && wasm)
+
+// Copyright 2026 The Nanolathe Authors
+// SPDX-License-Identifier: MIT
+package metal
+
+import (
+	"fmt"
+	"github.com/gogpu/wgpu/hal"
+	"sync/atomic"
+)
+
+// Dependency-local seam permits failure tests without native calls or mutable
+// process-global hooks. Production supplies the initialized ObjC runtime.
+type metalSubmissionRuntime struct {
+	gpuBlock   func(*atomic.Uint64, uint64) uintptr
+	frameBlock func(chan struct{}) uintptr
+	discard    func(uintptr)
+	attach     func(ID, uintptr)
+	commit     func(ID)
+}
+
+func nativeSubmissionRuntime() metalSubmissionRuntime {
+	return metalSubmissionRuntime{
+		gpuBlock: newGPUCompletionBlock, frameBlock: newFrameCompletionBlock,
+		discard: discardUnregisteredCompletionBlock,
+		attach:  func(id ID, block uintptr) { _ = MsgSend(id, Sel("addCompletedHandler:"), block) },
+		commit:  func(id ID) { _ = MsgSend(id, Sel("commit")) },
+	}
+}
+func discardUnregisteredCompletionBlock(ptr uintptr) {
+	if value, ok := blockPtrToID.LoadAndDelete(ptr); ok {
+		id := value.(uint64)
+		gpuCompletionRegistry.Delete(id)
+		frameCompletionRegistry.Delete(id)
+		blockPinRegistry.Delete(id)
+	}
+}
+
+func (q *Queue) submitWithRuntime(buffers []hal.CommandBuffer, rt metalSubmissionRuntime) (uint64, error) {
+	q.submissionMu.Lock()
+	defer q.submissionMu.Unlock()
+	// No new work means no new completion claim or semaphore consumption.
+	if len(buffers) == 0 {
+		return q.submissionIndex, nil
+	}
+	for i, buffer := range buffers {
+		cb, ok := buffer.(*CommandBuffer)
+		if !ok || cb == nil || cb.raw == 0 {
+			return 0, fmt.Errorf("metal: invalid command buffer %d; no commands committed", i)
+		}
+	}
+	index := q.submissionIndex + 1
+	gpu := rt.gpuBlock(&q.completedIndex, index)
+	if gpu == 0 {
+		return 0, fmt.Errorf("metal: GPU completion block unavailable; no commands committed")
+	}
+	var frame uintptr
+	if q.frameSemaphore != nil {
+		frame = rt.frameBlock(q.frameSemaphore)
+		if frame == 0 {
+			rt.discard(gpu)
+			return 0, fmt.Errorf("metal: frame completion block unavailable; no commands committed")
+		}
+	}
+	// All fallible validation/allocation precedes both native attachment and any
+	// commit. Only a real completion can return this semaphore token.
+	if q.frameSemaphore != nil {
+		<-q.frameSemaphore
+	}
+	last := buffers[len(buffers)-1].(*CommandBuffer).raw
+	rt.attach(last, gpu)
+	if frame != 0 {
+		rt.attach(last, frame)
+	}
+	for _, buffer := range buffers {
+		rt.commit(buffer.(*CommandBuffer).raw)
+	}
+	q.submissionIndex = index
+	return index, nil
+}
+
+type metalIdleRuntime struct {
+	create                        func() ID
+	retain, release, commit, wait func(ID)
+	status                        func(ID) uint
+}
+
+func (d *Device) waitIdleWithRuntime(rt metalIdleRuntime) error {
+	if d.queue != nil {
+		d.queue.submissionMu.Lock()
+		defer d.queue.submissionMu.Unlock()
+	}
+	buffer := rt.create()
+	if buffer == 0 {
+		return fmt.Errorf("metal: cannot allocate idle barrier; completion remains unknown")
+	}
+	rt.retain(buffer)
+	defer rt.release(buffer)
+	rt.commit(buffer)
+	rt.wait(buffer)
+	if status := rt.status(buffer); status != 4 {
+		return fmt.Errorf("metal: idle barrier status %d; completion remains unknown", status)
+	}
+	if d.queue != nil {
+		target := d.queue.submissionIndex
+		for {
+			current := d.queue.completedIndex.Load()
+			if current >= target || d.queue.completedIndex.CompareAndSwap(current, target) {
+				break
+			}
+		}
+	}
+	// Do not refill: registered callbacks own outstanding frame tokens and may
+	// still arrive. A refill would duplicate credits or block a callback forever.
+	return nil
+}
+
+// Submit validates and allocates both completion blocks before any commit.
+func (q *Queue) SubmitErrorsBeforeCommit() bool { return true }
