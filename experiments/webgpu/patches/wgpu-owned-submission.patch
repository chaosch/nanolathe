+func TestOwnedTextureDirtyRowsOffsetAndBoundedTail(t *testing.T) {
+	var scratch []byte
+	owner := &Texture{format: gputypes.TextureFormatRGBA8Unorm}
+	atlas := make([]byte, 32)
+	for i := range atlas {
+		atlas[i] = byte(i + 1)
+	}
+	packed, pitch, rows, err := packOwnedTextureData(&scratch, owner, atlas[4:24], &hal.ImageDataLayout{BytesPerRow: 12, RowsPerImage: 2}, &hal.Extent3D{Width: 1, Height: 2, DepthOrArrayLayers: 1})
+	if err != nil || pitch != 256 || rows != 2 || len(packed) != 512 {
+		t.Fatalf("dirty rows: %v", err)
+	}
+	for i := range 4 {
+		if packed[i] != atlas[4+i] || packed[256+i] != atlas[16+i] {
+			t.Fatal("valid partial final row was skipped")
+		}
+	}
+	for _, offset := range []uint64{0, 7} {
+		tail := make([]byte, 4096)
+		for i := range tail {
+			tail[i] = byte(i)
+		}
+		packed, pitch, _, err = packOwnedTextureData(&scratch, owner, tail, &hal.ImageDataLayout{Offset: offset, BytesPerRow: 256}, &hal.Extent3D{Width: 1, Height: 1, DepthOrArrayLayers: 1})
+		if err != nil || pitch != 256 || len(packed) != 256 || packed[0] != tail[offset] || packed[3] != tail[offset+3] {
+			t.Fatalf("unbounded/offset staging: %v", err)
+		}
+		for _, v := range packed[4:] {
+			if v != 0 {
+				t.Fatal("stale source padding leaked")
+			}
+		}
+	}
+	if _, _, _, err = packOwnedTextureData(&scratch, owner, atlas[:15], &hal.ImageDataLayout{BytesPerRow: 12}, &hal.Extent3D{Width: 1, Height: 2, DepthOrArrayLayers: 1}); err == nil {
+		t.Fatal("truly short texture source accepted")
+	}
+}
