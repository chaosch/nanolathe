+// Native asynchronous qualification currently covers reviewed Metal only.
+func (d *Device) CompletionSafeUploads() bool {
+	if d == nil || d.queue == nil {
+		return false
+	}
+	contract, ok := d.queue.hal.(interface{ SubmitErrorsBeforeCommit() bool })
+	return ok && contract.SubmitErrorsBeforeCommit()
+}
+
+// CompletionError exposes terminal unknown completion through the void Release API.
+func (d *Device) CompletionError() error {
+	if value, ok := failedDeviceTeardowns.Load(d); ok {
+		return value.(error)
+	}
+	return nil
+}
