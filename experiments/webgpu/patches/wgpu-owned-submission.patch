+func TestOwnedTextureRetirementWaitsForEveryPendingCopy(t *testing.T) {
+	device := &Device{}
+	texture := &Texture{device: device}
+	texture.AddPendingRef()
+	texture.AddPendingRef()
+	device.DestroyTexture(texture)
+	if texture.device == nil || !texture.pendingDestroy {
+		t.Fatal("texture retired while queued copies remained")
+	}
+	texture.DecPendingRef()
