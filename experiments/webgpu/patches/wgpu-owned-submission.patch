+	mapBuffer.Release()
+	device.Release()
+	if device.CompletionError() == nil || raw.destroyed != 1 || buffer.core.Ref.RefCount() != 1 {
+		t.Fatal("unknown submit lost at teardown")
+	}
+	// Test HAL has no GPU: explicitly drop the retained test-only batch.
+	value, _ := unknownSubmissionBatches.LoadAndDelete(device.Queue())
+	batch := value.(unknownSubmissionBatch)
+	if len(batch.commands) != 1 || batch.commands[0] != commands {
+		t.Fatal("quarantine borrowed caller slice")
+	}
+	commands.quarantined = false
+	commands.Release()
+	device.queue.pending.cancelFlush(batch.pending.cmdBuf, batch.pending.encoder, batch.pending.dstTextures, batch.pending.dstBuffers)
+	device.queue.submissionErr = nil
+	device.queue.release()
