+// Copyright 2026 The Nanolathe Authors
+// SPDX-License-Identifier: MIT
+
+//go:build darwin && !(js && wasm)
+
+package metal
+
+import (
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"github.com/go-webgpu/goffi/ffi"
+	"github.com/go-webgpu/goffi/types"
+)
+
+// Diagnostic on the exact v0.34.2 ABI: public MsgSend wrappers already describe
+// every explicit uintptr operand as Pointer. Do not use this path for mixed
+// float/struct calls. Unix goffi accepts at most 15 total pointer arguments,
+// including ObjC self/selector. Larger signatures retain the original path.
+const objcPointerCacheLimit = 13
+
+type objcPointerSignature struct {
+	once sync.Once
+	cif  types.CallInterface
+	err  error
+}
+
+var objcPointerSignatures [3][objcPointerCacheLimit + 1]objcPointerSignature
+
+type objcPointerFrame struct {
+	cif    types.CallInterface
+	values [objcPointerCacheLimit + 2]uintptr
+	args   [objcPointerCacheLimit + 2]unsafe.Pointer
+	result uint64
+}
+
+var objcPointerFrames = sync.Pool{New: func() any { return new(objcPointerFrame) }}
+
+func msgSendPointersCached(obj ID, sel SEL, ret *types.TypeDescriptor, args []uintptr) (uint64, error) {
+	if obj == 0 || sel == 0 {
+		return 0, nil
+	}
+	kind := 0
+	switch ret {
+	case types.PointerTypeDescriptor:
+	case types.UInt64TypeDescriptor:
+		kind = 1
+	case types.UInt8TypeDescriptor:
+		kind = 2
+	default:
+		var result uint64
+		err := msgSend(obj, sel, ret, unsafe.Pointer(&result), pointerArgs(args)...)
+		return result, err
+	}
+	if len(args) > objcPointerCacheLimit {
+		var result uint64
+		err := msgSend(obj, sel, ret, unsafe.Pointer(&result), pointerArgs(args)...)
+		return result, err
+	}
+	signature := &objcPointerSignatures[kind][len(args)]
+	signature.once.Do(func() {
+		descriptors := make([]*types.TypeDescriptor, len(args)+2)
+		for i := range descriptors {
+			descriptors[i] = types.PointerTypeDescriptor
+		}
+		signature.err = ffi.PrepareCallInterface(&signature.cif, types.DefaultCall, ret, descriptors)
+	})
+	if signature.err != nil {
+		return 0, signature.err
+	}
+	frame := objcPointerFrames.Get().(*objcPointerFrame)
+	// Separate CIF and argument/result storage for concurrent and reentrant calls.
+	// Cached type descriptors are immutable; no native address outlives this call.
+	frame.cif = signature.cif
+	frame.result = 0
+	frame.values[0], frame.values[1] = uintptr(obj), uintptr(sel)
+	copy(frame.values[2:], args)
+	for i := 0; i < len(args)+2; i++ {
+		frame.args[i] = unsafe.Pointer(&frame.values[i])
+	}
+	_, err := ffi.CallFunction(&frame.cif, objcMsgSendSymbol(ret), unsafe.Pointer(&frame.result), frame.args[:len(args)+2])
+	result := frame.result
+	runtime.KeepAlive(args)
+	runtime.KeepAlive(frame)
+	objcPointerFrames.Put(frame)
+	return result, err
+}
