+		{"missing-dynamic", validGroup, []uint32{256}, false},
+		{"excess-dynamic", validGroup, []uint32{256, 256, 0}, false},
+		{"missing-group", nil, nil, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			before := queue.submissionIndex
+			encoder := &CommandEncoder{device: d}
+			if err := encoder.BeginEncoding(test.name); err != nil {
+				t.Fatal(err)
+			}
+			pass := encoder.BeginRenderPass(&hal.RenderPassDescriptor{ColorAttachments: []hal.RenderPassColorAttachment{{View: view, LoadOp: gputypes.LoadOpClear, StoreOp: gputypes.StoreOpStore}}}).(*RenderPassEncoder)
+			pass.SetPipeline(p)
+			pass.SetBindGroup(0, bg0, nil)
+			if !test.missing {
+				pass.SetBindGroup(1, test.group, test.offsets)
+			}
+			pass.Draw(gputypes.DrawArgs{VertexCount: 3, InstanceCount: 1, FirstInstance: 5})
+			pass.End()
+			if cb, err := encoder.EndEncoding(); err == nil || cb != nil {
+				if cb != nil {
+					cb.Destroy()
+				}
+				t.Fatal("malformed range reached a command buffer")
+			}
+			if queue.submissionIndex != before {
+				t.Fatal("malformed range submitted GPU work")
+			}
+		})
+	}
+
+}
+
+func TestRuntimeRenderFixedShaderMinimumAfterDynamic(t *testing.T) {
+	source := `struct Params { values:array<vec4f,32> } @group(0) @binding(3) var<uniform> params:Params;`
+	ast, err := naga.Parse(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	module, err := naga.LowerWithSource(ast, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	minimum := renderShaderMinima(true, &ShaderModule{irModule: module})[[2]uint32{0, 3}]
+	if minimum != 512 {
+		t.Fatalf("fixed uniform shader minimum %d", minimum)
+	}
+	_, span, err := effectiveRenderSpan(1280, 0, 0, 1024)
+	if err != nil || span != 256 || span >= minimum {
+		t.Fatalf("dynamic fixed span %d minimum %d error %v", span, minimum, err)
+	}
