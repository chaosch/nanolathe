+	}{
+		{"physical-tail-after-dynamic", 1024, 256, 0, 256, 512, 512, false},
+		{"explicit-size-stays-fixed", 1024, 256, 128, 256, 512, 128, false},
+		{"explicit-overrun", 1024, 256, 768, 256, 0, 0, true},
+		{"base-overrun", 1024, 1025, 0, 0, 0, 0, true},
+		{"dynamic-overrun", 1024, 256, 0, 769, 0, 0, true},
+		{"offset-overflow", math.MaxUint64, math.MaxUint64 - 1, 0, 2, 0, 0, true},
+		{"uint32-semantic-limit", uint64(math.MaxUint32) + 1, 0, 0, 0, 0, 0, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			offset, span, err := effectiveRenderSpan(test.length, test.base, test.size, test.dynamic)
+			if (err != nil) != test.bad || (!test.bad && (offset != test.offset || span != test.span)) {
+				t.Fatalf("got %d %d %v", offset, span, err)
+			}
+		})
