+func TestRuntimeRenderCompilerLayoutGapsAndFieldOrder(t *testing.T) {
+	layout, _, _ := runtimeRenderLayout(t, &Device{})
+	for _, source := range []string{runtimeRenderVertex, runtimeRenderFragment} {
+		ast, err := naga.Parse(source)
+		if err != nil {
+			t.Fatal(err)
+		}
+		module, err := naga.LowerWithSource(ast, source)
+		if err != nil {
+			t.Fatal(err)
+		}
+		options, err := renderRuntimeOptions(module, layout)
+		if err != nil {
+			t.Fatal(err)
+		}
+		mapped := options.PerEntryPointMap["main"].Resources
+		if *mapped[ir.ResourceBinding{Group: 1, Binding: 2}].Buffer != 2 || *mapped[ir.ResourceBinding{Group: 1, Binding: 7}].Buffer != 3 {
+			t.Fatalf("layout gap slots wrong: %v", mapped)
+		}
+		text, info, err := msl.Compile(module, options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !info.RequiresSizesBuffer || !strings.Contains(text, "_buffer_sizes [[buffer(4)]]") {
+			t.Fatalf("sizes slot missing:\n%s", text)
+		}
+		if runtimeArrayMinimum(module, module.GlobalVariables[len(module.GlobalVariables)-1].Type) != 32 {
+			t.Fatal("struct prefix + one stride minimum incorrect")
+		}
+	}
+	module := &ir.Module{Types: []ir.Type{{Inner: ir.ArrayType{Stride: 4}}}, GlobalVariables: []ir.GlobalVariable{{Type: 0, Binding: &ir.ResourceBinding{}}}}
+	lib := &compiledLibrary{sizesBindings: []ir.ResourceBinding{{}}, sizesSlot: 30}
+	if _, err := newRenderBufferSizes(module, lib, 1); err == nil {
+		t.Fatal("vertex slot collision accepted")
+	}
+}
