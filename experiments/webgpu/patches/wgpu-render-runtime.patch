+func runtimeRenderLayout(t *testing.T, d *Device) (*PipelineLayout, *BindGroupLayout, *BindGroupLayout) {
+	t.Helper()
+	makeLayout := func(entries []gputypes.BindGroupLayoutEntry) *BindGroupLayout {
+		l, err := d.CreateBindGroupLayout(&hal.BindGroupLayoutDescriptor{Entries: entries})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return l.(*BindGroupLayout)
+	}
+	group0 := makeLayout([]gputypes.BindGroupLayoutEntry{{Binding: 0, Buffer: &gputypes.BufferBindingLayout{Type: gputypes.BufferBindingTypeUniform}}})
+	// Caller order differs from binding order; resources absent from each stage.
+	group1 := makeLayout([]gputypes.BindGroupLayoutEntry{
+		{Binding: 7, Buffer: &gputypes.BufferBindingLayout{Type: gputypes.BufferBindingTypeReadOnlyStorage, HasDynamicOffset: true}},
+		{Binding: 2, Buffer: &gputypes.BufferBindingLayout{Type: gputypes.BufferBindingTypeReadOnlyStorage, HasDynamicOffset: true}},
+		{Binding: 0, Buffer: &gputypes.BufferBindingLayout{Type: gputypes.BufferBindingTypeUniform}},
+	})
+	l, err := d.CreatePipelineLayout(&hal.PipelineLayoutDescriptor{BindGroupLayouts: []hal.BindGroupLayout{group0, group1}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return l.(*PipelineLayout), group0, group1
+}
