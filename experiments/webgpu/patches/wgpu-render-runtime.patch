+// This diagnostic is deliberately render-only. The existing compute binding
+// implementation and fixed-array pipeline compilation remain unchanged.
+type renderBufferSizes struct {
+	bindings []ir.ResourceBinding // naga field order, not Metal slot order
+	minimum  []uint64
+	slot     int
+}
+
+func (s renderBufferSizes) required() bool { return len(s.bindings) != 0 }
+
+func orderedLayoutEntries(layout *BindGroupLayout) []gputypes.BindGroupLayoutEntry {
+	entries := append([]gputypes.BindGroupLayoutEntry(nil), layout.entries...)
+	sort.Slice(entries, func(i, j int) bool { return entries[i].Binding < entries[j].Binding })
+	return entries
+}
+
+// Map every layout resource, including bindings absent from this shader stage.
+// A shader-global-only map would shift slots for layout gaps/separate modules.
+func renderRuntimeOptions(module *ir.Module, layout *PipelineLayout) (msl.Options, error) {
+	options := msl.DefaultOptions()
+	if layout == nil || layout.totalBuffers < 0 || layout.totalBuffers >= maxVertexBuffers {
+		return options, fmt.Errorf("metal: runtime render sizes have no available buffer slot")
+	}
+	resources := make(map[ir.ResourceBinding]msl.BindTarget)
+	var buffer, texture, sampler int
+	for group, iface := range layout.layouts {
+		bgl, ok := iface.(*BindGroupLayout)
+		if !ok || bgl == nil {
+			return options, fmt.Errorf("metal: invalid runtime render group layout %d", group)
+		}
+		for _, entry := range orderedLayoutEntries(bgl) {
+			binding := ir.ResourceBinding{Group: uint32(group), Binding: entry.Binding}
+			if _, exists := resources[binding]; exists {
+				return options, fmt.Errorf("metal: duplicate layout binding %v", binding)
+			}
+			var target msl.BindTarget
+			switch {
+			case entry.Buffer != nil:
+				if buffer >= maxVertexBuffers {
+					return options, fmt.Errorf("metal: too many render buffers")
+				}
+				index := uint8(buffer)
+				target.Buffer = &index
+				buffer++
+				target.Mutable = entry.Buffer.Type == gputypes.BufferBindingTypeStorage
+			case entry.Texture != nil || entry.StorageTexture != nil:
+				if texture >= 128 {
+					return options, fmt.Errorf("metal: too many render textures")
+				}
+				index := uint8(texture)
+				target.Texture = &index
+				texture++
+			case entry.Sampler != nil:
+				if sampler >= 16 {
+					return options, fmt.Errorf("metal: too many render samplers")
+				}
+				target.Sampler = &msl.BindSamplerTarget{Slot: uint8(sampler)}
+				sampler++
+			default:
+				return options, fmt.Errorf("metal: unsupported render binding %v", binding)
+			}
+			resources[binding] = target
+		}
+	}
+	if buffer != layout.totalBuffers {
+		return options, fmt.Errorf("metal: inconsistent render layout buffer count")
+	}
+	for _, global := range module.GlobalVariables {
+		if global.Binding == nil {
+			continue
+		}
+		target, exists := resources[*global.Binding]
+		if !exists || int(global.Type) >= len(module.Types) {
+			return options, fmt.Errorf("metal: shader binding %v absent from render layout", *global.Binding)
+		}
+		valid := target.Buffer != nil
+		switch module.Types[global.Type].Inner.(type) {
+		case ir.SamplerType:
+			valid = target.Sampler != nil
+		case ir.ImageType:
+			valid = target.Texture != nil
+		}
+		if !valid {
+			return options, fmt.Errorf("metal: shader/layout resource kind mismatch at %v", *global.Binding)
+		}
+	}
+	slot := uint8(layout.totalBuffers)
+	options.PerEntryPointMap = make(map[string]msl.EntryPointResources, len(module.EntryPoints))
+	for _, ep := range module.EntryPoints {
+		options.PerEntryPointMap[ep.Name] = msl.EntryPointResources{Resources: resources, SizesBuffer: &slot}
+	}
+	return options, nil
+}
+
+func runtimeArrayMinimum(module *ir.Module, handle ir.TypeHandle) uint64 {
+	if int(handle) >= len(module.Types) {
+		return 0
+	}
+	switch inner := module.Types[handle].Inner.(type) {
+	case ir.ArrayType:
+		if inner.Size.Constant == nil {
+			return uint64(inner.Stride)
+		}
+	case ir.StructType:
+		if len(inner.Members) > 0 {
+			last := inner.Members[len(inner.Members)-1]
+			if tail := runtimeArrayMinimum(module, last.Type); tail != 0 {
+				return max(uint64(last.Offset)+tail, uint64(ir.TypeSize(module, handle)))
+			}
+		}
+	}
+	return 0
+}
+
+func newRenderBufferSizes(module *ir.Module, lib *compiledLibrary, vertexBuffers int) (renderBufferSizes, error) {
+	out := renderBufferSizes{bindings: lib.sizesBindings, slot: lib.sizesSlot}
+	if !out.required() {
+		return out, nil
+	}
+	if out.slot < 0 || out.slot >= maxVertexBuffers-vertexBuffers || len(out.bindings)*4 > 4096 {
+		return out, fmt.Errorf("metal: render sizes slot collides with vertex attributes or exceeds limits")
+	}
+	out.minimum = make([]uint64, len(out.bindings))
+	for i, binding := range out.bindings {
+		for _, global := range module.GlobalVariables {
+			if global.Binding != nil && *global.Binding == binding {
+				out.minimum[i] = runtimeArrayMinimum(module, global.Type)
+				break
+			}
+		}
+		if out.minimum[i] == 0 {
+			return out, fmt.Errorf("metal: invalid runtime render type at %v", binding)
+		}
+	}
+	return out, nil
+}
+
+// Explicit binding sizes remain constant with dynamic offsets. An omitted size
+// binds the physical tail AFTER both offsets. Never clamp: arrayLength must be
+// exact and naga subtracts the prefix/first element using unsigned arithmetic.
+func effectiveRenderSpan(length, base, size, dynamic uint64) (uint64, uint64, error) {
+	if base > length || dynamic > length-base {
+		return 0, 0, fmt.Errorf("metal: render binding offset exceeds buffer")
+	}
+	offset := base + dynamic
+	available := length - offset
+	if size == 0 {
+		size = available
+	}
+	if size > available || size > math.MaxUint32 {
+		return 0, 0, fmt.Errorf("metal: runtime render binding size exceeds usable range")
+	}
+	return offset, size, nil
+}
+
+func (e *RenderPassEncoder) applyRuntimeBindGroup(index uint32, bg *BindGroup, offsets []uint32) error {
+	if e.currentLayout == nil || int(index) >= len(e.currentLayout.layouts) || int(index) >= len(e.currentLayout.groupOffsets) {
+		return fmt.Errorf("metal: runtime render group %d absent from pipeline", index)
+	}
+	layout, ok := e.currentLayout.layouts[index].(*BindGroupLayout)
+	if !ok || layout == nil || bg == nil {
+		return fmt.Errorf("metal: invalid runtime render group")
+	}
+	if e.bindingSizes == nil {
+		e.bindingSizes = make(map[[2]uint32]uint64)
+	}
+	for key := range e.bindingSizes {
+		if key[0] == index {
+			delete(e.bindingSizes, key)
+		}
+	}
+	base := e.currentLayout.groupOffsets[index]
+	buffer, texture, sampler := uintptr(base.Buffers), uintptr(base.Textures), uintptr(base.Samplers)
+	dynamicIndex := 0
+	for _, layoutEntry := range orderedLayoutEntries(layout) {
+		var entry *gputypes.BindGroupEntry
+		for i := range bg.entries {
+			if bg.entries[i].Binding == layoutEntry.Binding {
+				if entry != nil {
+					return fmt.Errorf("metal: duplicate render binding")
+				}
+				entry = &bg.entries[i]
+			}
+		}
+		if entry == nil {
+			return fmt.Errorf("metal: missing render binding %d", layoutEntry.Binding)
+		}
+		switch {
+		case layoutEntry.Buffer != nil:
+			res, ok := entry.Resource.(gputypes.BufferBinding)
+			if !ok || res.Buffer == 0 {
+				return fmt.Errorf("metal: invalid render buffer binding")
+			}
+			var dynamic uint64
+			if layoutEntry.Buffer.HasDynamicOffset {
+				if dynamicIndex >= len(offsets) {
+					return fmt.Errorf("metal: missing render dynamic offset")
+				}
+				dynamic = uint64(offsets[dynamicIndex])
+				dynamicIndex++
+			}
+			length := uint64(MsgSend(ID(res.Buffer), Sel("length")))
+			offset, size, err := effectiveRenderSpan(length, res.Offset, res.Size, dynamic)
+			if err != nil {
+				return err
+			}
+			if size < layoutEntry.Buffer.MinBindingSize {
+				return fmt.Errorf("metal: render binding below layout minimum")
+			}
+			e.bindingSizes[[2]uint32{index, entry.Binding}] = size
+			_ = MsgSend(e.raw, Sel("setVertexBuffer:offset:atIndex:"), res.Buffer, uintptr(offset), buffer)
+			_ = MsgSend(e.raw, Sel("setFragmentBuffer:offset:atIndex:"), res.Buffer, uintptr(offset), buffer)
+			buffer++
+		case layoutEntry.Texture != nil || layoutEntry.StorageTexture != nil:
+			res, ok := entry.Resource.(gputypes.TextureViewBinding)
+			if !ok {
+				return fmt.Errorf("metal: invalid render texture binding")
+			}
+			_ = MsgSend(e.raw, Sel("setVertexTexture:atIndex:"), res.TextureView, texture)
+			_ = MsgSend(e.raw, Sel("setFragmentTexture:atIndex:"), res.TextureView, texture)
+			texture++
+		case layoutEntry.Sampler != nil:
+			res, ok := entry.Resource.(gputypes.SamplerBinding)
+			if !ok {
+				return fmt.Errorf("metal: invalid render sampler binding")
+			}
+			_ = MsgSend(e.raw, Sel("setVertexSamplerState:atIndex:"), res.Sampler, sampler)
+			_ = MsgSend(e.raw, Sel("setFragmentSamplerState:atIndex:"), res.Sampler, sampler)
+			sampler++
+		}
+	}
+	if dynamicIndex != len(offsets) {
+		return fmt.Errorf("metal: excess render dynamic offsets")
+	}
+	return nil
+}
+
+func (e *RenderPassEncoder) bindRenderBufferSizes(metadata renderBufferSizes, selector string) error {
+	if !metadata.required() {
+		return nil
+	}
+	if len(metadata.bindings) > maxVertexBuffers || len(metadata.minimum) != len(metadata.bindings) {
+		return fmt.Errorf("metal: invalid render size metadata")
+	}
+	var sizes [maxVertexBuffers]uint32
+	for i, binding := range metadata.bindings {
+		size, ok := e.bindingSizes[[2]uint32{binding.Group, binding.Binding}]
+		if !ok || size < metadata.minimum[i] || size > math.MaxUint32 {
+			return fmt.Errorf("metal: missing/invalid runtime render range at %v", binding)
+		}
+		sizes[i] = uint32(size)
+	}
+	err := msgSendSetBytes(e.raw, Sel(selector), unsafe.Pointer(&sizes[0]), NSUInteger(len(metadata.bindings)*4), NSUInteger(metadata.slot))
+	runtime.KeepAlive(sizes)
+	return err
+}
+
+// Public late validation in this pin uses the pre-dynamic range. Validate
+// fixed globals too when either render stage takes the runtime diagnostic path.
+func renderShaderMinima(enabled bool, modules ...*ShaderModule) map[[2]uint32]uint64 {
+	if !enabled {
+		return nil
+	}
+	minimum := make(map[[2]uint32]uint64)
+	for _, module := range modules {
+		if module == nil || module.irModule == nil {
+			continue
+		}
+		for _, global := range module.irModule.GlobalVariables {
+			if global.Binding == nil || int(global.Type) >= len(module.irModule.Types) {
+				continue
+			}
+			switch module.irModule.Types[global.Type].Inner.(type) {
+			case ir.SamplerType, ir.ImageType:
+				continue
+			}
+			key := [2]uint32{global.Binding.Group, global.Binding.Binding}
+			minimum[key] = max(minimum[key], uint64(ir.TypeSize(module.irModule, global.Type)), runtimeArrayMinimum(module.irModule, global.Type))
+		}
+	}
+	return minimum
+}
+
+func (e *RenderPassEncoder) prepareRuntimeDraw() bool {
+	if !e.beginNative() || e.commandEncoder == nil || e.commandEncoder.recordErr != nil {
+		return false
+	}
+	if e.pipeline == nil {
+		e.commandEncoder.failRecording(fmt.Errorf("metal: missing render pipeline"))
+		return false
+	}
+	metadataChanged := e.runtimeBindingsDirty
+	if e.runtimeStateUsed && e.runtimeBindingsDirty {
+		clear(e.bindingSizes)
+		if e.pending != nil {
+			for i := range e.pending.bindGroups {
+				state := &e.pending.bindGroups[i]
+				if state.set && e.currentLayout != nil && i < len(e.currentLayout.layouts) {
+					if e.pipeline.vertexSizes.required() || e.pipeline.fragmentSizes.required() {
+						if err := e.applyRuntimeBindGroup(uint32(i), state.group, state.offsets[:state.offsetCount]); err != nil {
+							e.commandEncoder.failRecording(err)
+							return false
+						}
+					} else {
+						e.applyBindGroup(uint32(i), state.group, state.offsets[:state.offsetCount])
+					}
+				}
+			}
+		}
+		// A newly selected pipeline can start using previously unused slots.
+		if e.pending != nil {
+			for i := 0; i < e.pipeline.vertexBufferCount && i < len(e.pending.vertexBuffers); i++ {
+				state := &e.pending.vertexBuffers[i]
+				if state.set {
