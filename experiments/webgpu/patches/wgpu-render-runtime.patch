+	for _, source := range []string{
+		`struct Data { header:vec4u, tail:array<u32> } @group(0) @binding(0) var<storage,read> data:Data;`,
+		`struct Data { @size(64) header:u32, tail:array<u32> } @group(0) @binding(0) var<storage,read> data:Data;`,
