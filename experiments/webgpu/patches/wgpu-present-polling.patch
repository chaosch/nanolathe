+//go:build darwin && !(js && wasm)
+
+package metal
+
+import (
+	"testing"
+	"time"
+)
+
+func TestPresentationTrackerReturnsPoolCreditAndBalancesOwnRetains(t *testing.T) {
+	now := time.Unix(0, 0)
+	retains, releases := 0, 0
+	value := 0.0
+	tacker := &presentTelemetry{lastSubmission: map[uint64]uint64{}, ops: presentObservationOps{retain: func(ID) { retains++ }, release: func(ID) { releases++ }, read: func(ID) (float64, error) { return value, nil }, now: func() time.Time { return now }}}
+	for i := uint64(1); i <= 2; i++ {
+		tacker.add(ID(i), presentationObservation{Surface: 1, Submission: i}, true)
+	}
+	tacker.beforeAcquire()
+	if len(tacker.pending) != 1 || retains != 2 || releases != 1 {
+		t.Fatal("unresolved observations kept all drawable-pool credit", retains, releases)
+	}
+	now = now.Add(300 * time.Millisecond)
+	tacker.beforeAcquire()
+	if len(tacker.pending) != 0 || releases != 2 {
+		t.Fatal("timeout did not retire its owned retain")
+	}
+	tacker.add(3, presentationObservation{Surface: 1, Submission: 3}, true)
+	value = 42.0
+	snapshot := tacker.snapshot(true)
+	if snapshot.Presented != 1 || snapshot.Missing != 2 || snapshot.Outstanding != 0 || snapshot.Retains != snapshot.Releases || !snapshot.Closed {
+		t.Fatalf("unbalanced final snapshot %+v", snapshot)
+	}
+	tacker.add(4, presentationObservation{Surface: 1, Submission: 4}, true)
+	if retains != 3 {
+		t.Fatal("enqueue after final close retained a drawable")
+	}
+}
+
+func TestPresentationTrackerSurfaceCloseAndValueRing(t *testing.T) {
+	now := time.Unix(0, 0)
+	retained := map[ID]int{}
+	tracker := &presentTelemetry{lastSubmission: map[uint64]uint64{}, ops: presentObservationOps{retain: func(id ID) { retained[id]++ }, release: func(id ID) { retained[id]-- }, read: func(ID) (float64, error) { return 0, nil }, now: func() time.Time { return now }}}
+	tracker.add(1, presentationObservation{Surface: 1, Generation: 1, Submission: 1}, true)
+	tracker.add(2, presentationObservation{Surface: 2, Generation: 1, Submission: 2}, true)
+	tracker.closeSurface(1)
+	if retained[1] != 0 || retained[2] != 1 || len(tracker.pending) != 1 {
+		t.Fatal("surface retirement crossed ownership")
+	}
+	for i := 0; i < presentObservationLimit+10; i++ {
+		tracker.appendRow(presentationObservation{Ordinal: uint64(i)})
+	}
+	snapshot := tracker.snapshot(true)
+	if len(snapshot.Rows) != presentObservationLimit || snapshot.ValueEvictions == 0 || snapshot.Outstanding != 0 || retained[2] != 0 {
+		t.Fatal("value ring or final release failed")
+	}
+}
+
+func TestPresentationTrackerObservesRepeatedPresentsWithoutClaimingFreshSubmission(t *testing.T) {
+	now := time.Unix(0, 0)
+	tracker := &presentTelemetry{lastSubmission: map[uint64]uint64{}, ops: presentObservationOps{retain: func(ID) {}, release: func(ID) {}, read: func(ID) (float64, error) { return 42, nil }, now: func() time.Time { return now }}}
+	tracker.add(1, presentationObservation{Surface: 1, Submission: 1}, true)
+	tracker.add(2, presentationObservation{Surface: 1, Submission: 1}, true)
+	snapshot := tracker.snapshot(true)
+	if snapshot.Presented != 2 || !snapshot.Rows[0].FreshSubmission || snapshot.Rows[1].FreshSubmission {
+		t.Fatal("presentation and source freshness conflated")
+	}
+}
