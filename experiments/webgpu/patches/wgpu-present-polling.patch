@@ -0,0 +1,12 @@
+//go:build !rust && !(js && wasm)
+
+package wgpu
+
+func (d *Device) NativePresentationTelemetry(close bool) any {
+	if d != nil && d.queue != nil {
+		if provider, ok := d.queue.hal.(interface{ NativePresentationTelemetry(bool) any }); ok {
+			return provider.NativePresentationTelemetry(close)
+		}
+	}
+	return nil
+}
