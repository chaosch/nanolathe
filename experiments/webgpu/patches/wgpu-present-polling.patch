+//go:build darwin && !(js && wasm)
+
+package metal
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"runtime"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"github.com/go-webgpu/goffi/types"
+)
+
+const presentObservationLimit = 4096
+const presentRetainLimit = 2
+
+var nextDiagnosticSurface atomic.Uint64
+
+type presentationObservation struct {
+	Ordinal          uint64
+	Submission       uint64
+	Surface          uint64
+	Generation       uint64
+	Acquisition      uint64
+	AcquireMS        float64
+	PresentedSeconds float64
+	Reason           string
+	FreshSubmission  bool
+}
+type pendingPresentation struct {
+	drawable  ID
+	row       presentationObservation
+	requested time.Time
+}
+type presentObservationOps struct {
+	retain, release func(ID)
+	read            func(ID) (float64, error)
+	now             func() time.Time
+}
+type presentationSnapshot struct {
+	Enabled                                       bool
+	Closed                                        bool
+	Retains, Releases, Outstanding, HighWater     int
+	Requested, Presented, Missing, ValueEvictions uint64
+	Scope                                         string
+	Rows                                          []presentationObservation
+}
+type presentTelemetry struct {
+	nextRow                                         int
+	mu                                              sync.Mutex
+	closed                                          bool
+	ops                                             presentObservationOps
+	pending                                         []pendingPresentation
+	rows                                            []presentationObservation
+	ordinal, requested, presented, missing, evicted uint64
+	retains, releases, highWater                    int
+	lastSubmission                                  map[uint64]uint64
+}
+
+func nativePresentOps() presentObservationOps {
+	return presentObservationOps{retain: func(id ID) { Retain(id) }, release: Release, now: time.Now, read: func(drawable ID) (float64, error) {
+		if !msgSendBool(drawable, Sel("respondsToSelector:"), argPointer(uintptr(Sel("presentedTime")))) {
+			return 0, fmt.Errorf("presentedTime unsupported")
+		}
+		var value float64
+		err := msgSend(drawable, Sel("presentedTime"), types.DoubleTypeDescriptor, unsafe.Pointer(&value))
+		return value, err
+	}}
+}
+func (q *Queue) presentationDiagnostic() *presentTelemetry {
+	if q == nil {
+		return nil
+	}
+	q.presentInit.Do(func() {
+		if runtime.GOARCH == "arm64" && os.Getenv("NANOLATHE_WEBGPU_PRESENT_TELEMETRY") == "1" {
+			q.presentDiagnostic = &presentTelemetry{ops: nativePresentOps(), lastSubmission: make(map[uint64]uint64)}
+		}
+	})
+	return q.presentDiagnostic
+}
+func (t *presentTelemetry) finish(index int, seconds float64, reason string) {
+	p := t.pending[index]
+	t.ops.release(p.drawable)
+	t.releases++
+	p.row.PresentedSeconds = seconds
+	p.row.Reason = reason
+	if reason == "presented" {
+		t.presented++
+	} else {
+		t.missing++
+	}
+	t.appendRow(p.row)
+	copy(t.pending[index:], t.pending[index+1:])
+	t.pending = t.pending[:len(t.pending)-1]
+}
+func (t *presentTelemetry) appendRow(row presentationObservation) {
+	if len(t.rows) == presentObservationLimit {
+		t.rows[t.nextRow] = row
+		t.nextRow = (t.nextRow + 1) % presentObservationLimit
+		t.evicted++
+	} else {
+		t.rows = append(t.rows, row)
+	}
+}
+
+func (t *presentTelemetry) pollLocked(beforeAcquire bool) {
+	now := t.ops.now()
+	for i := 0; i < len(t.pending); {
+		value, err := t.ops.read(t.pending[i].drawable)
+		if err != nil {
+			t.finish(i, 0, "getter-error")
+			continue
+		}
+		if math.IsNaN(value) || math.IsInf(value, 0) || value < 0 {
+			t.finish(i, 0, "invalid-timestamp")
+			continue
+		}
+		if value > 0 {
+			t.finish(i, value, "presented")
+			continue
+		}
+		if now.Sub(t.pending[i].requested) >= 250*time.Millisecond {
+			t.finish(i, 0, "timeout-observation")
+			continue
+		}
+		i++
+	}
+	// The pool has3 drawables. Two unresolved extra retains plus a displayed
+	// drawable can block timeout-disabled nextDrawable forever: return credit
+	// before acquisition even when the timestamp never becomes positive.
+	if beforeAcquire {
+		for len(t.pending) > 1 {
+			t.finish(0, 0, "acquire-pool-credit")
+		}
+	}
+}
+func (t *presentTelemetry) beforeAcquire() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.closed {
+		t.pollLocked(true)
+	}
+}
+func (t *presentTelemetry) add(drawable ID, row presentationObservation, accepted bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	t.pollLocked(false)
+	t.ordinal++
+	t.requested++
+	row.Ordinal = t.ordinal
+	row.FreshSubmission = row.Submission > 0 && row.Submission > t.lastSubmission[row.Surface]
+	if !accepted {
+		row.Reason = "present-request-failed"
+		t.missing++
+		t.appendRow(row)
+		return
+	}
+	t.lastSubmission[row.Surface] = max(t.lastSubmission[row.Surface], row.Submission)
+	for len(t.pending) >= presentRetainLimit {
+		t.finish(0, 0, "retain-overflow")
+	}
+	t.ops.retain(drawable)
+	t.retains++
+	t.pending = append(t.pending, pendingPresentation{drawable: drawable, row: row, requested: t.ops.now()})
+	t.highWater = max(t.highWater, len(t.pending))
+}
+func (t *presentTelemetry) closeSurface(surface uint64) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	t.pollLocked(false)
+	for i := 0; i < len(t.pending); {
+		if t.pending[i].row.Surface == surface {
+			t.finish(i, 0, "surface-reconfigured-or-closed")
+		} else {
+			i++
+		}
+	}
+	delete(t.lastSubmission, surface)
+}
+func (t *presentTelemetry) snapshot(close bool) presentationSnapshot {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.closed {
+		t.pollLocked(false)
+		if close {
+			t.closed = true
+			for len(t.pending) > 0 {
+				t.finish(0, 0, "final-close-observation")
+			}
+		}
+	}
+	ordered := append([]presentationObservation(nil), t.rows[t.nextRow:]...)
+	ordered = append(ordered, t.rows[:t.nextRow]...)
+	sort.Slice(ordered, func(i, j int) bool { return ordered[i].Ordinal < ordered[j].Ordinal })
+	return presentationSnapshot{Enabled: true, Closed: t.closed, Retains: t.retains, Releases: t.releases, Outstanding: len(t.pending), HighWater: t.highWater, Requested: t.requested, Presented: t.presented, Missing: t.missing, ValueEvictions: t.evicted, Rows: ordered, Scope: "CAMetalDrawable presentedTime in Metal host-clock seconds; missing observations do not prove dropped display frames; derive cadence only from consecutive ordinals; no GPU timestamps or new waits"}
+}
+func (q *Queue) NativePresentationTelemetry(close bool) any {
+	if t := q.presentationDiagnostic(); t != nil {
+		return t.snapshot(close)
+	}
+	return presentationSnapshot{Enabled: false}
+}
+func (q *Queue) observePresent(s *Surface, st *SurfaceTexture, accepted bool) {
+	if t := q.presentationDiagnostic(); t != nil && s != nil && st != nil && st.drawable != 0 {
+		q.submissionMu.Lock()
+		index := q.submissionIndex
+		q.submissionMu.Unlock()
+		t.add(st.drawable, presentationObservation{Submission: index, Surface: s.diagnosticSurface, Generation: st.diagnosticGeneration, Acquisition: st.diagnosticAcquisition, AcquireMS: st.diagnosticAcquireMS}, accepted)
+	}
+}
