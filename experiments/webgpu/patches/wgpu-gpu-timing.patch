index 3b036b9..2774503 100644
--- a/hal/metal/queue.go
+++ b/hal/metal/queue.go
@@ -24,6 +24,8 @@ const maxFramesInFlight = 2
 
 // Queue implements hal.Queue for Metal.
 type Queue struct {
+	gpuTimingInit     sync.Once
+	gpuTiming         *gpuTiming
 	presentInit       sync.Once
 	presentDiagnostic *presentTelemetry
 	device            *Device
@@ -70,6 +72,10 @@ func (q *Queue) Submit(commandBuffers []hal.CommandBuffer) (uint64, error) {
 	pool := NewAutoreleasePool()
 	defer pool.Drain()
 
+	// Nanolathe measurement diagnostic: completed-handler GPU timings,
+	// attached before commit. Inert unless NANOLATHE_WEBGPU_GPU_TIMING=1.
+	q.observeGPUCommands(commandBuffers, subIdx)
+
 	lastIdx := len(commandBuffers) - 1
 	for i, buf := range commandBuffers {
 		cb, ok := buf.(*CommandBuffer)
