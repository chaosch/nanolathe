+//go:build !rust && !(js && wasm)
+
+package wgpu
+
+func (d *Device) NativeGPUTiming(close bool) any {
+	if d != nil && d.queue != nil {
+		if p, ok := d.queue.hal.(interface{ NativeGPUTiming(bool) any }); ok {
+			return p.NativeGPUTiming(close)
+		}
+	}
+	return nil
+}
+func (d *Device) NativeGPUClockSeconds() float64 {
+	if d != nil && d.queue != nil {
+		if p, ok := d.queue.hal.(interface{ NativeGPUClockSeconds() float64 }); ok {
+			return p.NativeGPUClockSeconds()
+		}
+	}
+	return 0
+}
