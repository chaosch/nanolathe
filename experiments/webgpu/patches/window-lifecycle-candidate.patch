 func (h *metalBattleHost) PreparationTimings() [12]float64 { return h.diagnosticStages }
+
+// These diagnostics run only while the serial source owner is idle.
+func (h *metalBattleHost) PresentationExtent() [2]int { return [2]int{h.width * 2, h.height * 2} }
+func (h *metalBattleHost) PresentationCursor() [2]int { return [2]int{h.cursorX, h.cursorY} }
+
+// ResizePhysicalExtent changes presentation only, after the host has joined Next.
+func (h *metalBattleHost) ResizePhysicalExtent(width, height int) error {
+	if width <= 0 || height <= 0 || width%2 != 0 || height%2 != 0 {
+		return fmt.Errorf("native source resize requires positive doubled logical dimensions")
+	}
+	if h.width*2 == width && h.height*2 == height {
+		return nil
+	}
+	h.width, h.height = width/2, height/2
+	h.cl.Resize(h.width, h.height)
+	h.battle.setSurfaceSize(int32(h.width), int32(h.height))
+	h.world.SetViewport(width, height)
+	h.cached = false
+	var pal palette.Tables
+	if source := h.cl.PaletteTables(); source != nil {
+		pal = *source
+	}
+	pal.Base = h.cl.DisplayPalette()
+	h.hud = metalhud.New(&pal, h.width, h.height)
+	h.displayPalette = pal.Base
+	h.atlasEpoch += h.atlasLocalVersion + 1
+	h.atlasLocalVersion = 0
+	return nil
+}
