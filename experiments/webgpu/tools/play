#!/usr/bin/env python3
"""One-command native play test. Production defaults/module remain unchanged."""
import hashlib, os, pathlib, subprocess, sys, tempfile
exp=pathlib.Path(__file__).resolve().parents[1];repo=exp.parent.parent
if sys.platform!='darwin':sys.exit('The real-battle host is currently qualified on macOS only.')
h=hashlib.sha256()
for f in sorted(exp.rglob('*')):
 if f.is_file() and (f.suffix in ('.go','.wgsl','.mod','.sum') or f.name in ('build-play','play')):h.update(str(f.relative_to(exp)).encode());h.update(f.read_bytes())
h.update(subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo))
cache=pathlib.Path(tempfile.gettempdir())/('nanolathe-webgpu-play-'+h.hexdigest()[:16]);binary=cache/'Nanolathe WebGPU Prototype.app/Contents/MacOS/nanolathe-webgpu'
if not binary.exists():
 if cache.exists():sys.exit('Incomplete previous build at '+str(cache)+'; use tools/build-play with a fresh output directory.')
 subprocess.run([str(exp/'tools/build-play'),str(cache)],check=True)
env=dict(os.environ,GOWORK='off',GOMAXPROCS=os.environ.get('GOMAXPROCS','2'))
report_args=[]
if not any(a=='--webgpu-report' or a.startswith('--webgpu-report=') for a in sys.argv[1:]):
 report=pathlib.Path(tempfile.mkdtemp(prefix='nanolathe-webgpu-playtest-'))/'report'
 report_args=['--webgpu-report',str(report)]
 print('Play-test report:',report,flush=True)
args=[str(binary),'--webgpu','--root',str(pathlib.Path.home()/'TotalAnnihilation'),'--map','Great Divide','--mod','none','--gameplay','modern','--renderer','modern','--ai-player','2=modern','--webgpu-size','1920x1080',*report_args,*sys.argv[1:]]
print('WebGPU prototype:',binary,flush=True)
os.execve(str(binary),args,env)
