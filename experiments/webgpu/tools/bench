#!/usr/bin/env python3
"""Validate P0/P2/P3 before launching prebuilt runs; a failed gate emits unrun evidence."""
import argparse, hashlib, json, os, pathlib, subprocess, sys, time
root=pathlib.Path(__file__).resolve().parents[1]
p=argparse.ArgumentParser()
p.add_argument('--backend',required=True,choices=['go','rust','browser','metal'])
p.add_argument('--binary',type=pathlib.Path)
p.add_argument('--output',required=True,type=pathlib.Path)
p.add_argument('--qualification',required=True,type=pathlib.Path)
p.add_argument('--environment',required=True,type=pathlib.Path)
p.add_argument('--inventory-only',action='store_true')
a=p.parse_args();out=a.output.resolve()
if out.is_relative_to(root.parent.parent):p.error('output must be outside repository')
q=json.loads(a.qualification.read_text());env=json.loads(a.environment.read_text())
status=q['paths'][a.backend]
shader_hashes={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted((root/'internal/render').glob('*.wgsl'))}
ready=all(status.get(key)=='pass' for key in ['P0','P2','P3'])
if a.backend=='metal':ready=False # independent comparison uses its own public runner protocol; no WebGPU acceptance claim
if not a.inventory_only and not ready:p.error('dependency gate not green: '+status.get('reason','missing P0/P2/P3 evidence')+'; use --inventory-only to record unrun matrix')
if not a.inventory_only and (not a.binary or not a.binary.is_file()):p.error('a prebuilt binary is required')
if out.exists():p.error('use a new output directory')
out.mkdir(parents=True)
workloads=[(1000,200,1920,1080,'animated'),(3000,200,1920,1080,'animated'),(5000,200,1920,1080,'animated'),(3000,500,1920,1080,'animated'),(3000,200,3456,2160,'animated'),(3000,200,1920,1080,'static'),(3000,200,1920,1080,'camera')]
# Hash all fixture configurations by an asset-free helper; no device creation.
configs=json.loads(subprocess.check_output(['go','run','./cmd/webgpu-manifest'],cwd=root,env=dict(os.environ,GOWORK='off',CGO_ENABLED='0',GOMAXPROCS='2'),text=True))
repo=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip()
modules=subprocess.check_output(['go','list','-m','all'],cwd=root,env=dict(os.environ,GOWORK='off'),text=True)
for round in range(1,4):
 for count,detail,w,h,mode in workloads:
  name=f'round-{round}-{count}-{detail}-{w}x{h}-{mode}';dest=out/name;dest.mkdir()
  key=f'{count}/{detail}/{w}/{h}/{mode}'
  manifest=dict(schema=1,repository_commit=repo,gogpu_commit='12620c9d50073b8591f075c97ba0c6f3b6ad92f7',modules=modules,backend=a.backend,shader_sha256=shader_hashes,workload=configs[key],environment=env,qualification=status,round=round,warmup=240,measured=3600,clock='tick=d//4; alpha=(d%4)/4',native_artifact=q.get('native_artifacts',{}).get(a.backend),adapter=q.get('adapter',{}).get(a.backend),binary_sha256=hashlib.sha256(a.binary.read_bytes()).hexdigest() if a.binary else None,status='unrun' if a.inventory_only else 'pending')
  (dest/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
  if a.inventory_only:
   (dest/'frames.csv').write_text('index,generation,cpu_prepare_ms,cpu_pack_ms,cpu_encode_ms,cpu_submit_ms,ring_wait_ms,gpu_ms,queue_completion_latency_ms,callback_interval_ms,presented_ms,input_to_submit_ms,draws,dispatches,instances,pieces,triangles,upload_bytes,endpoint_bytes,persistent_creations,live_resources,live_bytes\n')
   (dest/'summary.json').write_text(json.dumps(dict(status='unrun',reason=status.get('reason'),measured_draws=0,metrics=None,throughput=None,gpu_ms=None,presentation_ms=None,input_to_submission_ms=None),indent=2)+'\n');continue
  if a.backend=='browser':p.error('browser requires a real browser session at the emitted URL, local Download report and external host lock held for the complete sequence; no headless fallback')
  cmd=[str(a.binary.resolve()),'-workload','-measure',f'-count={count}',f'-detail={detail}',f'-width={w//2}',f'-height={h//2}',f'-physical-width={w}',f'-physical-height={h}',f'-mode={mode}',f'-refresh={env["display"]["refresh_hz"]}',f'-out={dest}']
  (dest/'command.json').write_text(json.dumps(cmd,indent=2)+'\n')
  with (dest/'run.log').open('w') as log:
   result=subprocess.run([str(root.parent.parent/'tools/host-run'),'env','GOMAXPROCS=2',*cmd],stdout=log,stderr=subprocess.STDOUT)
  if result.returncode:sys.exit('run failed; dependent sweep stopped: '+name)
print(out)
