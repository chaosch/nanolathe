#!/usr/bin/env python3
"""Launch a verified prototype build with an explicit, reversible profile."""
import argparse, hashlib, json, os, pathlib, platform, sys
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--build',type=pathlib.Path,help='build directory; packaged launcher defaults to its own directory')
parser.add_argument('--fast',action='store_true',help='source preparation ahead, storage reservation and late drawable acquisition on the stock pinned dependencies; every native target')
parser.add_argument('--late-acquire',action=argparse.BooleanOptionalAction,default=None,help='acquire the drawable only after source preparation; on by default with --fast')
parser.add_argument('--gpu-timing',action='store_true',help='bounded Metal completed-command timing observations; also enables presented telemetry; needs a --gpu-timing build')
parser.add_argument('--telemetry',action='store_true',help='bounded native presented-handler observations; needs a --present-handler build')
parser.add_argument('--neutral-pointer',action='store_true',help='bounded interactive field diagnostic only; center camera/pointer and suppress shake for reproducible workload')
parser.add_argument('--dry-run',action='store_true',help='print command and managed environment without launching')
parser.add_argument('game_args',nargs=argparse.REMAINDER)
opts=parser.parse_args();build=(opts.build or pathlib.Path(__file__).resolve().parent).resolve()
manifest_path=build/'build-manifest.json'
if not manifest_path.is_file():parser.error('provide --build for a tools/build-play output directory')
manifest=json.loads(manifest_path.read_text());diagnostics=manifest.get('dependency_diagnostic',{})
target=manifest.get('target',{'goos':'darwin','goarch':'arm64','binary':'nanolathe-webgpu'})
binary=build/target['binary']
if not binary.is_file():parser.error('provide --build for a tools/build-play output directory')
if target['goos']=='js':parser.error('a js/wasm build runs in a browser; serve it with tools/serve-battle')
host_os={'Darwin':'darwin','Linux':'linux','Windows':'windows'}.get(platform.system())
if host_os!=target['goos']:parser.error(f"build targets {target['goos']}/{target['goarch']}; run it on that platform")
if hashlib.sha256(binary.read_bytes()).hexdigest()!=manifest['binary_sha256']:parser.error('binary digest differs from its build manifest')
late=opts.fast if opts.late_acquire is None else opts.late_acquire
if opts.gpu_timing and not diagnostics.get('gpu_timing'):parser.error('--gpu-timing requires a --gpu-timing build')
if opts.gpu_timing:opts.telemetry=True
if opts.telemetry and not diagnostics.get('present_handler'):parser.error('--telemetry requires a --present-handler build')
# Profiles control prototype diagnostics, never settings files, content or OS
# preferences. Clear inherited QA flags so the selected profile is reproducible.
env=dict(os.environ)
for key in list(env):
 if key.startswith('NANOLATHE_WEBGPU_'):del env[key]
ahead=opts.fast
managed={'NANOLATHE_WEBGPU_PREPARE_AHEAD':'1' if ahead else '0','NANOLATHE_WEBGPU_RESERVE_STORAGE':'1' if ahead else '0','NANOLATHE_WEBGPU_PRESENT_TELEMETRY':'1' if opts.telemetry else '0'}
managed['NANOLATHE_WEBGPU_LATE_ACQUIRE']='1' if late else '0'
managed['NANOLATHE_WEBGPU_GPU_TIMING']='1' if opts.gpu_timing else '0'
if ahead:managed['GOMAXPROCS']=str(min(8,max(4,os.cpu_count() or 4)))  # the host overlaps world, effects and foreground work
if opts.neutral_pointer:managed['NANOLATHE_WEBGPU_BENCHMARK_NEUTRAL_POINTER']='1'
env.update(managed)
args=opts.game_args
if args and args[0]=='--':args=args[1:]
benchmark=any(a=='--battle-benchmark' or a.startswith('--battle-benchmark=') for a in args)
webgpu_flags=[a for a in args if a.startswith('-') and a.lstrip('-').split('=',1)[0]=='webgpu']
for flag in webgpu_flags:
 if '=' in flag and flag.split('=',1)[1] not in ('1','t','T','true','TRUE','True'):parser.error('prototype launcher cannot disable --webgpu')
if benchmark and webgpu_flags:parser.error('native benchmark uses --benchmark-renderer=webgpu without --webgpu')

# Main dispatches --webgpu before general benchmark composition. Keep explicit
# native benchmark routing separate from the ordinary interactive window flag.
if benchmark:
 if '--benchmark-renderer=webgpu' not in args:parser.error('native benchmark requires --benchmark-renderer=webgpu')
 prefix=[]
else:prefix=[] if '--webgpu' in args else ['--webgpu']
cmd=[str(binary),*prefix,*args]
summary={'profile':'fast' if opts.fast else 'baseline','target':target,'telemetry':opts.telemetry,'late_acquire':late,'command':cmd,'managed_environment':managed,'settings_selection_preserved':env.get('NANOLATHE_SETTINGS')==os.environ.get('NANOLATHE_SETTINGS'),'scope':'prototype environment only; no saved preferences changed'}
if opts.dry_run:print(json.dumps(summary,indent=2));sys.exit(0)
print('nanolathe: prototype profile '+summary['profile']+'; saved settings preserved',file=sys.stderr,flush=True)
os.execve(cmd[0],cmd,env)
