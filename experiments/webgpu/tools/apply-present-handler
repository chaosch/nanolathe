#!/usr/bin/env python3
"""Apply the guarded present-handler diagnostic to an existing external copy."""
import hashlib,json,pathlib,platform,subprocess,sys
exp=pathlib.Path(__file__).resolve().parents[1];repo=exp.parent.parent
if len(sys.argv)!=2:sys.exit('usage: tools/apply-present-handler REVIEWED_EXTERNAL_WGPU_COPY')
if platform.system()!='Darwin' or platform.machine()!='arm64':sys.exit('presented handler diagnostic is currently qualified only on macOS arm64')
target=pathlib.Path(sys.argv[1]).resolve()
module_cache=pathlib.Path(subprocess.check_output(['go','env','GOMODCACHE'],text=True).strip()).resolve()
if not target.is_dir() or target.is_relative_to(repo) or target.is_relative_to(module_cache):sys.exit('requires an external working copy, never the checkout or module cache')
manifest=json.loads((exp/'patches/present-handler-manifest.json').read_text())
patch=exp/'patches/wgpu-present-handler.patch'
if hashlib.sha256(patch.read_bytes()).hexdigest()!=manifest['patch_sha256']:sys.exit('handler patch digest mismatch')
for rel,digest in manifest['original_sha256'].items():
 if hashlib.sha256((target/rel).read_bytes()).hexdigest()!=digest:sys.exit('unexpected reviewed base: '+rel)
for rel in manifest['added_files']:
 if (target/rel).exists():sys.exit('handler added file conflict: '+rel)
subprocess.run(['git','apply','--check',str(patch)],cwd=target,check=True)
subprocess.run(['git','apply',str(patch)],cwd=target,check=True)
for rel,digest in manifest['current_sha256'].items():
 if hashlib.sha256((target/rel).read_bytes()).hexdigest()!=digest:sys.exit('handler result digest mismatch: '+rel)
print(target)
