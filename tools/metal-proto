#!/bin/sh
# Isolated macOS prototype. No tests; native shader compilation happens at startup.
# Pure Go by default; NANOLATHE_METAL_DYLIB=1 builds and runs the Objective-C
# reference bridge instead (needs clang and the macOS SDK).
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ "$(uname -s)" != Darwin ]; then
    echo 'nanolathe: Metal prototype requires macOS' >&2
    exit 1
fi
: "${GOMAXPROCS:=2}"
: "${NANOLATHE_TEST_P:=2}"
. tools/go-budget
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
library=go
if [ "${NANOLATHE_METAL_DYLIB:-0}" = 1 ]; then
    tools/host-run xcrun clang -dynamiclib -fobjc-arc -O3 -Wall -Wextra \
        -framework Cocoa -framework Metal -framework QuartzCore \
        internal/platform/metalproto/native/bridge.m -o "$work/libnanometal.dylib"
    library="$work/libnanometal.dylib"
fi
tools/host-run go build -o "$work/nanolathe-metal" ./cmd/nanolathe-metal
"$work/nanolathe-metal" --library "$library" "$@"
