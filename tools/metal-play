#!/bin/sh
# Throwaway macOS host: production battle shell, retained native Metal world.
# Pure Go: only the Go toolchain is needed. NANOLATHE_METAL_DYLIB=1 also
# builds the Objective-C reference bridge with clang and runs that instead.
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ "$(uname -s)" != Darwin ]; then
    echo 'nanolathe: Metal prototype requires macOS' >&2
    exit 1
fi
# A match uses Go's default processor count, as the production game does.
# Set GOMAXPROCS=2 for the benchmark's stress budget.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
library=go
if [ "${NANOLATHE_METAL_DYLIB:-0}" = 1 ]; then
    xcrun clang -dynamiclib -fobjc-arc -O3 -Wall -Wextra \
        -framework Cocoa -framework Metal -framework QuartzCore \
        internal/platform/metalproto/native/bridge.m -o "$work/libnanometal.dylib"
    library="$work/libnanometal.dylib"
fi
CGO_ENABLED=0 go build -o "$work/nanolathe" ./cmd/nanolathe
output="${TMPDIR:-/tmp}/nanolathe-metal-match-$(date +%Y%m%d-%H%M%S)-$$"
"$work/nanolathe" --metal-prototype "$output" --metal-library "$library" --map 'The Pass' --ai-player all=modern "$@"
